{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "plansDirectory": "docs/plans",
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.test)",
      "Read(**/.env.staging)",
      "Read(**/.env.production)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/.dev.vars)"
    ],
    "ask": [
      "Bash(drizzle-kit push*)",
      "Bash(* drizzle-kit push*)",
      "Bash(*drizzle-kit drop*)",
      "Bash(dropdb *)",
      "Bash(*DROP DATABASE*)",
      "Bash(*drop database*)",
      "Bash(*DROP SCHEMA*)",
      "Bash(*drop schema*)",
      "Bash(*TRUNCATE*)",
      "Bash(*truncate table*)",
      "Bash(*docker compose down -v*)",
      "Bash(*docker compose down --volumes*)",
      "Bash(*docker volume rm*)"
    ]
  },
  "sandbox": {
    "excludedCommands": [
      "bun run dev",
      "bun run dev:down",
      "bun run test",
      "bun run db:migrate",
      "bun run --cwd apps/server db:migrate",
      "bun run --cwd apps/server test"
    ]
  }
}
