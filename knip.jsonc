{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "project": ["scripts/**/*.mjs"],
    },
    // Run after the server's `build:types`: the declarations it emits (dist/types, the package's
    // export) are an entry, and only they name @simplewebauthn/server, through better-auth's
    // passkey plugin (TS2883).
    "apps/server": {
      "entry": ["src/main.ts", "src/contract.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"],
    },
    "packages/ui": {
      "entry": ["src/**/*.test.tsx"],
      "project": ["src/**/*.{ts,tsx}"],
    },
    "packages/tokens": {
      "entry": ["*.test.mjs"],
    },
    "tooling/playwright-web": {
      "entry": ["reset-database.ts"],
      "ignoreDependencies": ["@repo/server", "web"],
    },
  },
}
