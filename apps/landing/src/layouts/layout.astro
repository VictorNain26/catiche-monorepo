---
import { Font } from 'astro:assets';
import scales from '@repo/tokens/scales.json';
import '@/styles/global.css';
import Header from '@/components/layout/header.astro';
import Footer from '@/components/layout/footer.astro';
import JsonLd from '@/components/json-ld.astro';
import { BRAND_NAME } from '@/lib/brand';
import { OG_IMAGE } from '@/lib/open-graph';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const TITLE = `${BRAND_NAME} – Aide aux devoirs au collège : apprendre à s'organiser`;
// The product in the present, from docs/produit.md, under 160 characters; its state is on the page (docs/charte.md).
const DESCRIPTION = `${BRAND_NAME}, l'aide aux devoirs du collège, de la 6e à la 3e : chaque soir, Tom aide votre collégien à s'organiser, sans faire le travail à sa place.`;
const { title, description = DESCRIPTION, noindex = false } = Astro.props;
const pageTitle = title ? `${title} | ${BRAND_NAME}` : TITLE;
const site = Astro.site?.href ?? '';
const ogImage = new URL('/opengraph-image.png', site).href;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: BRAND_NAME,
    url: site,
    logo: new URL('/icon-512.png', site).href,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    url: site,
    name: BRAND_NAME,
    inLanguage: 'fr',
  },
];
---

<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* The browser bar takes the page's background, in each mode (the step theme.css's background points at). */}
    <meta name="theme-color" media="(prefers-color-scheme: light)" content={scales.light['mist-1']} />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content={scales.dark['mist-1']} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="application-name" content={BRAND_NAME} />
    <meta name="robots" content={noindex ? 'noindex' : 'index, follow'} />
    {!noindex && <link rel="canonical" href={new URL(Astro.routePattern, site).href} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={BRAND_NAME} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(OG_IMAGE.width)} />
    <meta property="og:image:height" content={String(OG_IMAGE.height)} />
    {/* The same picture on every page: its alt says what it shows, not the page. */}
    <meta property="og:image:alt" content={TITLE} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={TITLE} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" type="image/x-icon" />
    <link rel="icon" href="/icon.png" sizes="64x64" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-icon.png" sizes="180x180" type="image/png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Font cssVariable="--font-brand-text" preload />
    <Font cssVariable="--font-brand-heading" preload />
    {jsonLd.map((schema) => (
      <JsonLd data={schema} />
    ))}
  </head>
  <body>
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-primary focus:text-primary-foreground focus:rounded-full"
    >
      Aller au contenu principal
    </a>
    {/* The top the logo brings back (atoms/logo.astro): focusable by script only, so that the keyboard's focus follows
     * the page up, and the next Tab starts again from the header. */}
    <div id="top" tabindex="-1" class="relative flex min-h-screen flex-col outline-none">
      <Header />
      <main id="main-content" class="flex-1">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
