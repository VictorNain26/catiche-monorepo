---
import { Image } from 'astro:assets';
import { BRAND_NAME } from '@/lib/brand';
import tomTete from '@repo/ui/assets/tom-tete.png';

// On the home page the logo brings back the top of the page without reloading it: « #top » is the page's frame
// (layouts/layout.astro), which takes the focus with the scroll, smooth unless reduced motion asks otherwise
// (styles/global.css); elsewhere, the home.
// Built as files (astro.config.mjs), the home page's path is « /index.html ».
const HOME = /^\/(?:index(?:\.html)?)?$/u;
const HREF = HOME.test(Astro.url.pathname) ? '#top' : '/';
---

<a
  href={HREF}
  aria-label={`${BRAND_NAME} - Accueil`}
  class="inline-flex min-h-11 items-center gap-2 font-heading text-2xl font-extrabold text-primary transition-opacity duration-base hover:opacity-80"
>
  <Image src={tomTete} alt="" width={40} height={40} densities={[1, 2]} class="size-10" />
  {BRAND_NAME}
</a>
