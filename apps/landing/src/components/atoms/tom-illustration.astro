---
import { Image } from 'astro:assets';
import { Pause, Play } from '@lucide/astro';
import { cn } from '@repo/ui/classes';
import tom from '@/assets/tom.png';

interface Props {
  class?: string;
  // On the top of the page Tom moves at once; further down, once he is in view.
  start?: 'load' | 'view';
  // The arch, the entrance of the holt, behind Tom on the top of the site only (docs/charte.md, "Formes et composition").
  arch?: boolean;
}

const { class: className, start = 'load', arch = false } = Astro.props;
const CLIPS = ['salut', 'respiration'] as const;
---

<tom-illustration data-start={start} class={cn('relative block w-full max-w-sm', className)}>
  <span role="img" aria-label="Tom, une loutre en pull bleu avec un stylo dans la poche" class="relative block aspect-square w-full">
    {arch && <span aria-hidden="true" class="absolute inset-x-1/16 top-1/24 bottom-0 rounded-t-full bg-arch"></span>}
    <Image src={tom} alt="" width={384} height={384} densities={[1, 2]} class="relative size-full" />
    {CLIPS.map((clip) => (
      <video
        data-clip={clip}
        aria-hidden="true"
        muted
        playsinline
        loop={clip === 'respiration'}
        preload="none"
        class="invisible absolute inset-0 size-full"
      >
        {/* Safari drops VP9 alpha, so it must meet its HEVC source first. */}
        <source src={`/tom/${clip}.mov`} type='video/mp4; codecs="hvc1"' />
        <source src={`/tom/${clip}.webm`} type="video/webm" />
      </video>
    ))}
  </span>
  {/* Tom moves for more than five seconds: the visitor can stop him (WCAG 2.2.2). Shown only once he moves. */}
  <button
    type="button"
    data-toggle
    hidden
    class="absolute top-0 right-0 inline-flex min-h-11 items-center gap-2 rounded-control px-3 text-sm font-bold text-foreground transition-colors duration-base hover:bg-accent"
  >
    <Pause data-icon="pause" class="size-4" aria-hidden="true" />
    <Play data-icon="play" class="hidden size-4" aria-hidden="true" />
    <span data-label>Pause</span>
  </button>
</tom-illustration>

<script>
  class TomIllustration extends HTMLElement {
    connectedCallback() {
      const picture = this.querySelector('img');
      const salut = this.querySelector<HTMLVideoElement>('video[data-clip="salut"]');
      const respiration = this.querySelector<HTMLVideoElement>('video[data-clip="respiration"]');
      const toggle = this.querySelector<HTMLButtonElement>('[data-toggle]');
      if (!picture || !salut || !respiration || !toggle) return;
      // Autoplay can be refused (iOS Low Power Mode), and nothing moves under reduced motion: Tom then stays still.
      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

      let current = salut;
      const show = (shown: HTMLElement) => {
        for (const frame of [picture, salut, respiration]) frame.classList.toggle('invisible', frame !== shown);
      };
      // The button says what it does next: its label changes, not a pressed state. It follows the video itself, so a
      // refused play() leaves it on « Lecture ».
      const sync = () => {
        const paused = current.paused;
        toggle.querySelector('[data-icon="pause"]')?.classList.toggle('hidden', paused);
        toggle.querySelector('[data-icon="play"]')?.classList.toggle('hidden', !paused);
        const label = toggle.querySelector('[data-label]');
        if (label) label.textContent = paused ? 'Lecture' : 'Pause';
      };
      const resume = () => {
        current.play().catch(sync);
      };

      salut.addEventListener('playing', () => {
        show(salut);
        toggle.hidden = false;
      });
      salut.addEventListener('ended', () => {
        current = respiration;
        resume();
      });
      respiration.addEventListener('playing', () => {
        show(respiration);
      });
      for (const video of [salut, respiration]) {
        video.addEventListener('play', sync);
        video.addEventListener('pause', sync);
      }
      toggle.addEventListener('click', () => {
        if (current.paused) resume();
        else current.pause();
      });

      if (this.dataset['start'] === 'view') {
        const observer = new IntersectionObserver(
          (entries) => {
            if (entries.some((entry) => entry.isIntersecting)) {
              observer.disconnect();
              resume();
            }
          },
          { threshold: 0.6 },
        );
        observer.observe(this);
      } else {
        resume();
      }
    }
  }

  customElements.define('tom-illustration', TomIllustration);
</script>
