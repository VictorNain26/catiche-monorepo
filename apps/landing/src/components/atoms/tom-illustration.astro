---
import { Image } from 'astro:assets';
import { cn } from '@repo/ui/classes';
import tom from '@/assets/tom.png';
import { BRAND_NAME } from '@/lib/brand';

interface Props {
  class?: string;
  // On the top of the page Tom waves the first time he is seen; at the end, once his arrival (an `.arrival` around him) is over.
  start?: 'load' | 'arrival';
}

const { class: className, start = 'load' } = Astro.props;
// At the end of the page, his wave is the page's goodbye: a screen reader hears it too.
const label = `Tom, le tuteur de ${BRAND_NAME}, a l’allure d’une loutre.${start === 'arrival' ? ' Il vous fait un signe de la main.' : ''}`;
---

{/* Tom stands on the page itself, without a shape behind him. He waves once, in less than five seconds, so that no Pause
 * button is needed (WCAG 2.2.2), then stays on the wave's last frame. His still picture is the page without scripts. */}
<tom-illustration data-start={start} class={cn('relative block w-full max-w-sm', className)}>
  <span role="img" aria-label={label} class="relative block aspect-square w-full">
    <Image src={tom} alt="" width={384} height={384} densities={[1, 2]} class="relative size-full" />
    <video aria-hidden="true" muted playsinline preload="none" class="invisible absolute inset-0 size-full">
      {/* Safari drops VP9 alpha, so it must meet its HEVC source first. */}
      <source src="/tom/salut.mov" type='video/mp4; codecs="hvc1"' />
      <source src="/tom/salut.webm" type="video/webm" />
    </video>
  </span>
</tom-illustration>

<script>
  import { arrivalEnded, IN_VIEW, inView } from '@/scripts/timing';

  class TomIllustration extends HTMLElement {
    connectedCallback() {
      const picture = this.querySelector('img');
      const wave = this.querySelector('video');
      if (!picture || !wave) return;
      // Autoplay can be refused (iOS Low Power Mode), and nothing moves under reduced motion: Tom then stays still.
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      if (reducedMotion.matches) return;

      const show = (shown: HTMLElement) => {
        for (const frame of [picture, wave]) frame.classList.toggle('invisible', frame !== shown);
      };
      // Reduced motion turned on during the visit: Tom stops on his still picture, for good.
      const still = () => {
        wave.pause();
        show(picture);
      };
      reducedMotion.addEventListener('change', (event) => {
        if (event.matches) still();
      });
      // The video shows only once it plays; a play() that resolves after reduced motion turned on stops at once. Once
      // ended, it stays on its last frame.
      wave.addEventListener('playing', () => {
        if (reducedMotion.matches) still();
        else show(wave);
      });
      const waveOnce = () => {
        if (reducedMotion.matches) return;
        wave.play().catch(() => {
          show(picture);
        });
      };

      const arrival = this.dataset['start'] === 'arrival' ? this.closest<HTMLElement>('.arrival') : null;
      if (arrival) {
        // He waves once his arrival is over (its script plays it as it comes into view, src/scripts/reveal.ts), so that
        // the start of the wave is not lost while he still fades in. No arrival, under reduced motion: no wave either.
        const onEnd = (event: TransitionEvent) => {
          if (!arrivalEnded(event, arrival)) return;
          arrival.removeEventListener('transitionend', onEnd);
          waveOnce();
        };
        arrival.addEventListener('transitionend', onEnd);
      } else {
        // He waves the first time he is seen: at a computer, at once; on a phone, where he stands below the window, once
        // he is scrolled to.
        const observer = new IntersectionObserver(
          (entries) => {
            if (!entries.some(inView)) return;
            observer.disconnect();
            waveOnce();
          },
          { threshold: IN_VIEW },
        );
        observer.observe(this);
      }
    }
  }

  customElements.define('tom-illustration', TomIllustration);
</script>
