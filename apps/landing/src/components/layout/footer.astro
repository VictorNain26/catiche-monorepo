---
import ExternalLink from '@/components/atoms/external-link.astro';
import Logo from '@/components/atoms/logo.astro';
import { AUTHOR_URL, BRAND_NAME, CONTACT_EMAIL } from '@/lib/brand';

// The page is built once: the year is the build's.
const YEAR = new Date().getFullYear();

// Help and the legal pages only: the home page's sections are in the header.
const LINKS = [
  { href: '/aide', label: 'Centre d’aide' },
  { href: '/contact', label: 'Contact' },
  { href: '/confidentialite', label: 'Confidentialité' },
  { href: '/cgu', label: 'CGU' },
  { href: '/mentions-legales', label: 'Mentions légales' },
];
---

{/* On the page's own background, where the last section's plane ends: one end, without a band of its own. In a row
 * from a computer's width; stacked below it, where a row would squeeze the links. */}
<footer class="bg-background text-foreground">
  <div class="container flex flex-col gap-6 py-12 lg:flex-row lg:items-center lg:justify-between">
    <div class="space-y-1">
      <Logo />
      <p class="text-sm text-muted-foreground">
        <a href={`mailto:${CONTACT_EMAIL}`} class="inline-flex min-h-11 items-center underline-offset-4 hover:underline">
          {CONTACT_EMAIL}
        </a>{' '}
        · © {YEAR} {BRAND_NAME}
      </p>
      {/* Its publisher, as the legal notice names him (pages/mentions-legales.astro). */}
      <p class="text-sm text-muted-foreground">
        {BRAND_NAME} est conçu et développé par{' '}
        <ExternalLink href={AUTHOR_URL} class="min-h-11 underline underline-offset-4">
          Victor Lenain
        </ExternalLink>
        .
      </p>
    </div>
    <nav aria-label="Aide et informations légales">
      <ul class="flex flex-wrap gap-x-6 text-sm">
        {LINKS.map((link) => (
          <li>
            <a
              href={link.href}
              class="inline-flex min-h-11 items-center text-foreground underline-offset-4 transition-colors duration-base hover:underline"
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</footer>
