---
import { cn } from '@repo/ui/classes';

// A fragment of the application's screen, drawn in HTML until the app's redesign gives real ones. It only
// illustrates: a text beside it, for screen readers, says what it shows, so they skip it.
// Its top line is the day and the hour, as a phone's clock writes them (sections/evening-data.ts, `screenTime`).
interface Props {
  time: string;
  class?: string;
}

const { time, class: className } = Astro.props;
---

<div aria-hidden="true" class={cn('rounded-2xl bg-card p-4 text-card-foreground sm:p-5 shadow-control ring-1 ring-border', className)}>
  <p class="mb-4 border-b pb-3 text-sm font-bold text-muted-foreground tabular-nums">{time}</p>
  <slot />
</div>
