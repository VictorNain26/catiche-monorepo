---
import { buttonVariants, cn } from '@repo/ui/classes';
import { CONTACT_EMAIL, SIGN_IN_URL } from '@/lib/brand';

// The one call to action: the application's sign-in page, where accounts open on invitation (apps/server/src/platform/auth/auth.ts);
// an invitation is asked for by e-mail, without a waiting list.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class={cn('flex flex-col items-start gap-3', className)}>
  <a href={SIGN_IN_URL} class={buttonVariants({ size: 'lg' })}>
    Ouvrir l&apos;application
  </a>
  <p class="max-w-sm text-muted-foreground">
    En préparation, pour le collège de la 6e à la&nbsp;3e&nbsp;: les comptes s&apos;ouvrent sur invitation. Pour en demander une, écrivez-nous à{' '}
    <a href={`mailto:${CONTACT_EMAIL}`} class="text-primary underline underline-offset-4">
      {CONTACT_EMAIL}
    </a>
    .
  </p>
</div>
