---
import { buttonVariants, cn } from '@repo/ui/classes';
import ExternalLink from '@/components/atoms/external-link.astro';
import { BRAND_NAME, CONTACT_EMAIL, SIGN_IN_URL } from '@/lib/brand';

// What a visitor can do today: accounts open on invitation (apps/server/src/platform/auth/auth.ts), asked for by e-mail,
// without a waiting list; an invited parent signs in to the application.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const REQUEST_HREF = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(`Demande d'invitation à ${BRAND_NAME}`)}`;
---

<div class={cn('flex flex-col items-start gap-4', className)}>
  <a href={REQUEST_HREF} class={buttonVariants({ size: 'lg' })}>
    Demander une invitation
  </a>
  <p class="text-muted-foreground">
    Déjà invité&nbsp;?{' '}
    <ExternalLink href={SIGN_IN_URL} class="min-h-11 text-primary underline underline-offset-4">
      Se connecter
    </ExternalLink>
  </p>
</div>
