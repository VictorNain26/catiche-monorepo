---
import { Mail } from '@lucide/astro';
import { buttonVariants, cn } from '@repo/ui/classes';
import ExternalLink from '@/components/atoms/external-link.astro';
import { BRAND_NAME, CONTACT_EMAIL, SIGN_IN_URL } from '@/lib/brand';

// What a visitor can do today: accounts open on invitation (apps/server/src/platform/auth/auth.ts), asked for by e-mail,
// without a waiting list; an invited adult signs in to the application. With `status`, the line under the button is
// the state of Catiche, as a pill, and signing in stays in the header; without it, the sign-in link.
interface Props {
  class?: string;
  status?: string;
}

const { class: className, status } = Astro.props;
const REQUEST_HREF = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(`Demande d'invitation à ${BRAND_NAME}`)}`;
---

<div class={cn('flex flex-col items-start gap-4', className)}>
  {/* The envelope says the button opens an e-mail. */}
  <a href={REQUEST_HREF} class={cn(buttonVariants({ size: 'lg' }), 'h-14 px-8 text-lg shadow-control')}>
    <Mail class="size-5" aria-hidden="true" />
    Demander une invitation
  </a>
  {status ? (
    <p class="inline-flex items-center gap-2 rounded-full bg-secondary px-3 py-1 text-foreground">
      <span aria-hidden="true" class="size-2 shrink-0 rounded-full bg-annotation" />
      {status}
    </p>
  ) : (
    <p class="text-foreground">
      Déjà invité&nbsp;?{' '}
      <ExternalLink href={SIGN_IN_URL} class="min-h-11 text-primary underline underline-offset-4">
        Se connecter
      </ExternalLink>
    </p>
  )}
</div>
