---
import { Menu, X } from '@lucide/astro';
import { buttonVariants } from '@repo/ui/classes';
import NavLinks from './nav-links.astro';
import ExternalLink from '@/components/atoms/external-link.astro';
import Logo from '@/components/atoms/logo.astro';
import { SIGN_IN_URL } from '@/lib/brand';
---

<mobile-menu>
  <button
    type="button"
    data-open
    aria-haspopup="dialog"
    aria-label="Ouvrir le menu"
    class={buttonVariants({ variant: 'ghost', size: 'icon', className: 'lg:hidden' })}
  >
    <Menu class="size-5" aria-hidden="true" />
  </button>
  <dialog
    aria-label="Menu"
    class="fixed inset-y-0 right-0 left-auto m-0 h-dvh max-h-none w-3/4 max-w-none border-l bg-background p-0 shadow-lg backdrop:bg-overlay/80 sm:max-w-sm"
  >
    {/* Fills the dialog, so that only a click on the backdrop lands on the dialog itself. Its top row, at the header's
     * height, holds the logo and the close button, in the ink of the text; the dialog opens on the close button. */}
    <div class="flex h-full flex-col gap-4 px-6 pb-6">
      <div class="-mr-4 flex h-16 shrink-0 items-center justify-between">
        <Logo />
        <button
          type="button"
          data-close
          autofocus
          class="inline-flex size-11 items-center justify-center rounded-full text-foreground transition-colors duration-base hover:bg-accent"
        >
          <X class="size-5" aria-hidden="true" />
          <span class="sr-only">Fermer</span>
        </button>
      </div>
      <nav aria-label="Principale" class="flex flex-col gap-4">
        <NavLinks orientation="vertical" />
      </nav>
      <ExternalLink href={SIGN_IN_URL} class={buttonVariants({ variant: 'outline', className: 'self-start' })}>
        Se connecter
      </ExternalLink>
    </div>
  </dialog>
</mobile-menu>

<style>
  /* The button opens the menu only once its script has defined the element: until then, and without scripts, it is
   * not shown, rather than a button that does nothing. */
  mobile-menu:not(:defined) [data-open] {
    display: none;
  }

  /* A modal dialog leaves the page behind it scrollable: the open menu locks it. */
  :global(html:has(dialog[open])) {
    overflow: hidden;
  }
</style>

<script>
  class MobileMenu extends HTMLElement {
    connectedCallback() {
      const dialog = this.querySelector('dialog');
      if (!dialog) return;
      this.querySelector('[data-open]')?.addEventListener('click', () => {
        dialog.showModal();
      });
      // The close button, a link followed, or a click on the backdrop, which only the dialog itself receives.
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog || (event.target instanceof Element && event.target.closest('[data-close], a'))) dialog.close();
      });
    }
  }

  customElements.define('mobile-menu', MobileMenu);
</script>
