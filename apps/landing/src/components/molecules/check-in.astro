---
// What is done and what is left at the end of the evening, on the pupil's screen and on the parent's
// (docs/produit.md, "Le point du soir"); a screen adds its own lines after them.
interface Props {
  done: string;
  left: string;
}

const { done, left } = Astro.props;
---

<dl class="space-y-3">
  <div>
    <dt class="text-sm font-bold text-muted-foreground">Fait</dt>
    <dd>{done}</dd>
  </div>
  <div>
    <dt class="text-sm font-bold text-muted-foreground">Reste</dt>
    <dd>{left}</dd>
  </div>
  <slot />
</dl>
