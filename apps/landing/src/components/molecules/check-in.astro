---
// What is done and what is left at the end of the evening, on the screen of the evening check-in
// (docs/produit.md, "Le point du soir"); on the pupil's screen, what goes in the bag too.
interface Props {
  done: string;
  left: string;
  bag?: string;
}

const { done, left, bag } = Astro.props;
const LINES = [{ term: 'Fait', detail: done }, { term: 'Reste', detail: left }, ...(bag ? [{ term: 'Dans le cartable', detail: bag }] : [])];
---

<dl class="space-y-3">
  {LINES.map(({ term, detail }) => (
    <div>
      <dt class="text-sm font-bold text-muted-foreground">{term}</dt>
      <dd>{detail}</dd>
    </div>
  ))}
</dl>
