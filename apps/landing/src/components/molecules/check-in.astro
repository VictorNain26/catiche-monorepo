---
// What is done and what is left at the end of the evening, on the screen of the evening check-in
// (docs/produit.md, "Le point du soir").
interface Props {
  done: string;
  left: string;
}

const { done, left } = Astro.props;
---

<dl class="space-y-3">
  <div>
    <dt class="text-sm font-bold text-muted-foreground">Fait</dt>
    <dd>{done}</dd>
  </div>
  <div>
    <dt class="text-sm font-bold text-muted-foreground">Reste</dt>
    <dd>{left}</dd>
  </div>
</dl>
