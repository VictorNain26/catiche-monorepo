---
// What is done, what is left and what goes in the bag at the end of the evening, on the pupil's screen at 18:50
// (sections/evening.astro).
interface Props {
  done: string;
  left: string;
  bag: string;
}

const { done, left, bag } = Astro.props;
const LINES = [
  { term: 'Fait', detail: done },
  { term: 'Reste', detail: left },
  { term: 'Dans le cartable', detail: bag },
];
---

<dl class="space-y-3">
  {LINES.map(({ term, detail }) => (
    <div>
      <dt class="text-sm font-bold text-muted-foreground">{term}</dt>
      <dd>{detail}</dd>
    </div>
  ))}
</dl>
