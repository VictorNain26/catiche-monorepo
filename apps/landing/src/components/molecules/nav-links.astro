---
import { cn } from '@repo/ui/classes';
import { SECTION_LINKS } from '@/lib/navigation';

interface Props {
  orientation?: 'horizontal' | 'vertical';
}

const { orientation = 'horizontal' } = Astro.props;
---

<div class={cn('flex', orientation === 'vertical' ? 'flex-col space-y-4' : 'items-center gap-4')}>
  {SECTION_LINKS.map((link) => (
    <a
      href={link.href}
      class={cn(
        'min-h-11 items-center font-bold whitespace-nowrap text-foreground transition-colors duration-base hover:text-primary',
        // In the menu, at a finger's reading size.
        orientation === 'vertical' ? 'flex text-lg' : 'inline-flex px-2 text-sm',
      )}
    >
      {link.label}
    </a>
  ))}
</div>
