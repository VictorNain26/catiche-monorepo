---
import { X } from '@lucide/astro';
import FadeIn from '@/components/atoms/fade-in.astro';

const LIMITS = [
  'Il ne fait pas les devoirs à la place de votre enfant.',
  "Il est conçu pour ne pas donner la réponse d'un exercice.",
  'Il ne promet pas de meilleures notes.',
  "Il ne remplace ni l'enseignant, ni vous.",
];
---

<section class="py-16 lg:py-24">
  <FadeIn class="container grid max-w-5xl gap-8 md:grid-cols-[2fr_3fr] md:items-center md:gap-12">
    <h2 class="text-4xl text-balance text-foreground sm:text-5xl">Ce que Tom ne fait pas</h2>
    <ul class="grid gap-4 text-lg text-foreground sm:grid-cols-2">
      {LIMITS.map((limit) => (
        <li class="flex gap-3 rounded-2xl bg-card p-4 ring-1 ring-border">
          <X class="mt-1 size-5 shrink-0 text-muted-foreground" aria-hidden="true" />
          {limit}
        </li>
      ))}
    </ul>
  </FadeIn>
</section>
