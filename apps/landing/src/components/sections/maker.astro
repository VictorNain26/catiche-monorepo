---
import { BRAND_NAME, CONTACT_EMAIL } from '@/lib/brand';
---

{/*
  TODO(victor): a neutral draft, NOT to be merged as is. Only Victor's name is known here: his own words replace it
  (who he is, why he makes Catiche, one commitment), and nothing else is asserted until he has validated it.
*/}
<section class="py-16 lg:py-24">
  <div class="container grid max-w-6xl gap-6 lg:grid-cols-[1fr_2fr] lg:gap-16">
    <h2 class="text-4xl text-balance text-foreground sm:text-5xl">Qui fait {BRAND_NAME}</h2>
    <p class="max-w-2xl text-lg text-muted-foreground md:text-xl lg:pt-2">
      {BRAND_NAME} est conçu et construit par Victor Lenain. Pour lui écrire&nbsp;:{' '}
      <a href={`mailto:${CONTACT_EMAIL}`} class="font-bold text-primary underline underline-offset-4">
        {CONTACT_EMAIL}
      </a>
      .
    </p>
  </div>
</section>
