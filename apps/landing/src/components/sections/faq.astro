---
import FaqList from './faq-list.astro';
---

<section id="faq" class="scroll-mt-20 bg-secondary py-12 md:py-16 lg:py-32">
  <div class="container grid max-w-6xl gap-6 md:gap-10 lg:grid-cols-12 lg:gap-16">
    {/* In two columns, the title stays in view under the fixed header (h-16) while the questions open. */}
    <div class="lg:sticky lg:top-24 lg:col-span-4 lg:self-start">
      <h2 class="text-3xl text-balance text-foreground sm:text-4xl">Vos questions</h2>
      <p class="mt-4 text-muted-foreground">
        Une autre question&nbsp;?{' '}
        <a href="/contact" class="text-primary underline underline-offset-4">
          Écrivez-nous
        </a>
        .
      </p>
    </div>
    <FaqList class="lg:col-span-8" />
  </div>
</section>
