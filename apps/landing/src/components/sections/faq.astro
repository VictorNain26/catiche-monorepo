---
import FaqList from './faq-list.astro';
---

<section id="faq" class="scroll-mt-20 plane-secondary py-28 md:py-32 lg:py-40">
  <div class="container grid max-w-5xl gap-6 md:gap-10 lg:grid-cols-12 lg:gap-12">
    {/* In two columns, the title stays in view under the fixed header (h-16) while the questions open. The title rises,
     * then the questions come in a quick cascade. */}
    <play-once class="block lg:sticky lg:top-24 lg:col-span-5 lg:self-start">
      <h2 data-reveal="rise" class="section-title text-foreground">
        Vos questions
      </h2>
      <p data-reveal="rise" data-order="2" class="mt-4 text-foreground">
        Une autre question&nbsp;?{' '}
        <a href="/contact" class="text-primary underline underline-offset-4">
          Écrivez-nous
        </a>
        .
      </p>
    </play-once>
    <play-once class="block lg:col-span-7">
      <FaqList />
    </play-once>
  </div>
</section>
