---
import PupilSays from '@/components/molecules/pupil-says.astro';
import Screen from '@/components/molecules/screen.astro';
import TomSays from '@/components/molecules/tom-says.astro';
import { BAG, EVENING, FIRST_SAID, HOMEWORK, HOURS, MISSING } from './evening-data';

// The evening of docs/produit.md, "Ce que fait Catiche", and its gestures in docs/methode.md, "Les gestes d'une soirée":
// the product presented in the present, as docs/produit.md describes it; its state is said once, at the top of the page
// (docs/charte.md, "Les mots").
// A question or a hint is the bottom of Tom's ladder (docs/tuteur.md, § 3). One sentence and one screen per moment, on a
// single line of time from 17:30 to 18:50.
const MOMENTS = [
  {
    time: HOURS.said,
    title: "Dire ce qu'il a ce soir",
    body: 'Votre collégien dit ses devoirs à voix haute, et Tom demande ce qui manque.',
    screen: EVENING,
  },
  {
    time: HOURS.ordered,
    title: 'Choisir par quoi commencer',
    body: 'Tom propose un ordre, que votre collégien peut changer.',
    screen: "L'ordre",
  },
  {
    time: HOURS.started,
    title: 'Avancer par petites étapes',
    body: 'Tom découpe chaque devoir en étapes courtes, et aide par une question ou un indice.',
    screen: 'Maths · exercice 3',
  },
  {
    time: HOURS.ended,
    title: 'Préparer demain',
    body: "Tom aide votre collégien à préparer son cartable. Il garde l'histoire à réviser demain, pour le contrôle de jeudi.",
    screen: 'Pour demain',
  },
] as const;

const STEPS = [
  { step: "Relire l'énoncé", state: 'fait' },
  { step: "Écrire ce qu'on cherche", state: 'en cours' },
  { step: 'Faire le calcul', state: '' },
];

// The jumble falling into Tom's order plays at the top of the page; here, the order is already proposed, and the pupil
// changes it, the one thing docs/produit.md says he can do with it: English first.
const [maths, history, english] = HOMEWORK;
const CHANGED = [english, maths, history];
---

<section id="soiree" class="scroll-mt-20 bg-background py-10 md:py-20 lg:py-28">
  <div class="container max-w-5xl">
    <div class="max-w-3xl">
      <h2 class="text-3xl text-balance text-foreground sm:text-4xl">Une soirée avec Tom</h2>
      <p class="mt-3 text-lg text-foreground md:mt-4 md:text-xl">Un mardi soir, de 17:30 au cartable prêt.</p>
    </div>

    {/* One line of time, the thread of the evening: on a phone on the left, at a computer in the middle, the screens
     * changing side from one moment to the next. The line is drawn beside the list, on the same axis as its dots. */}
    <div class="evening relative mt-10 lg:mt-16">
      <span aria-hidden="true" class="absolute top-2 bottom-2 left-3 w-0.5 -translate-x-1/2 rounded-full bg-border lg:left-1/2">
        <span class="rail-fill absolute inset-0 rounded-full bg-primary"></span>
      </span>
      <ol role="list">
        {MOMENTS.map(({ time, title, body, screen }, index) => (
          <li role="listitem" class="moment relative pl-10 lg:grid lg:grid-cols-2 lg:items-center lg:gap-20 lg:pl-0">
            <span
              aria-hidden="true"
              class="absolute top-2 left-3 size-3 -translate-x-1/2 rounded-full bg-primary ring-4 ring-background lg:top-1/2 lg:left-1/2 lg:-translate-y-1/2"
            ></span>
            <div class:list={[index % 2 === 1 && 'lg:order-2']}>
              <h3 class="text-xl text-balance text-foreground sm:text-2xl">
                <time datetime={time} class="mb-1 block font-heading text-2xl font-extrabold text-primary tabular-nums lg:text-3xl">
                  {time}
                </time>
                {title}
              </h3>
              <p class="mt-1 max-w-md text-foreground sm:mt-2 sm:text-lg">{body}</p>
            </div>

            <div class:list={['mt-4 lg:mt-0', index % 2 === 1 && 'lg:order-1']}>
              {/* The hour is the moment's, just above or beside it: the screen keeps only its name. */}
              <Screen title={screen}>
                {index === 0 && (
                  <div class="space-y-3">
                    {/* The screen stops on Tom's question: his answer is the top of the page, at 17:35. */}
                    <PupilSays>{FIRST_SAID}</PupilSays>
                    <TomSays>{MISSING}</TomSays>
                  </div>
                )}
                {index === 1 && (
                  <div class="space-y-3">
                    <PupilSays>Je préfère commencer par l&apos;anglais.</PupilSays>
                    <TomSays>D&apos;accord. Puis les maths, elles sont pour demain.</TomSays>
                    <ol class="divide-y rounded-control ring-1 ring-border">
                      {CHANGED.map(({ subject, note }, position) => (
                        <li class="flex items-baseline gap-3 px-3 py-2">
                          <span class="font-heading font-extrabold tabular-nums">{position + 1}</span>
                          <span class="font-bold">{subject}</span>
                          {note && <span class="ml-auto text-sm text-muted-foreground">{note}</span>}
                        </li>
                      ))}
                    </ol>
                  </div>
                )}
                {index === 2 && (
                  <div class="space-y-3">
                    <ol class="space-y-2">
                      {STEPS.map(({ step, state }, position) => (
                        <li
                          class:list={[
                            'flex items-baseline gap-3 rounded-control px-3 py-2',
                            state === 'en cours' ? 'bg-accent text-accent-foreground' : 'ring-1 ring-border',
                          ]}
                        >
                          <span class="font-heading font-extrabold tabular-nums">{position + 1}</span>
                          <span class:list={['relative', state === 'fait' && 'text-muted-foreground']}>
                            {step}
                            {state === 'fait' && (
                              <svg class="strike" viewBox="0 0 100 6" preserveAspectRatio="none" aria-hidden="true">
                                <path d="M1 4 C 25 2, 60 5, 99 2" />
                              </svg>
                            )}
                          </span>
                          {state && (
                            <span class:list={['ml-auto text-sm', state === 'en cours' ? 'text-accent-muted-foreground' : 'text-muted-foreground']}>
                              {state}
                            </span>
                          )}
                        </li>
                      ))}
                    </ol>
                    <TomSays>Qu&apos;est-ce que l&apos;exercice te demande de trouver&nbsp;?</TomSays>
                  </div>
                )}
                {index === 3 && (
                  <div>
                    {/* The bag, drawn by its handle and its body. */}
                    <span class="mx-auto block h-4 w-16 rounded-t-control border-2 border-b-0 border-input"></span>
                    <div class="rounded-2xl border-2 border-input px-4 pt-3 pb-4">
                      <p class="text-sm font-bold text-muted-foreground">Dans le cartable</p>
                      <ul class="mt-2 space-y-1.5">
                        {BAG.map((item) => (
                          <li>{item}</li>
                        ))}
                      </ul>
                    </div>
                  </div>
                )}
              </Screen>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .moment + .moment {
    margin-top: calc(var(--spacing) * 8);
  }

  @media (width >= 64rem) {
    .moment + .moment {
      margin-top: calc(var(--spacing) * 16);
    }
  }

  /* The line of time fills as the evening is read: the only move of the section, tied to the scroll where the browser
   * can; elsewhere, and under reduced motion, it is full. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .evening {
        view-timeline: --evening block;
      }

      .rail-fill {
        transform-origin: top;
        animation: rail-fill linear both;
        animation-timeline: --evening;
        animation-range: entry 25% exit 75%;
      }
    }
  }

  @keyframes rail-fill {
    from {
      scale: 1 0;
    }
  }

  /* The line that strikes the step done. */
  .strike {
    position: absolute;
    inset-inline: calc(var(--spacing) * -1);
    top: 50%;
    width: calc(100% + var(--spacing) * 2);
    height: calc(var(--spacing) * 1.5);
    overflow: visible;
    fill: none;
    stroke: var(--color-foreground);
    stroke-width: calc(var(--spacing) / 2);
    stroke-linecap: round;
  }
</style>
