---
import CheckIn from '@/components/molecules/check-in.astro';
import EveningTimeline from '@/components/molecules/evening-timeline.astro';
import Exercise from '@/components/molecules/exercise.astro';
import Proof from '@/components/molecules/proof.astro';
import PupilSays from '@/components/molecules/pupil-says.astro';
import Screen from '@/components/molecules/screen.astro';
import TomSays from '@/components/molecules/tom-says.astro';
import { spokenHour } from '@/lib/hours';
import { BAG, CHECK_IN, HOMEWORK, HOURS, screenTime } from './evening-data';

// The evening of docs/produit.md, "Ce que fait Catiche", and its gestures in docs/methode.md, "Les gestes d'une soirée":
// the product presented in the present, as docs/produit.md describes it (docs/charte.md, "Les mots"); the pupil acts in
// each title. A question or a hint is the bottom of Tom's ladder (docs/tuteur.md, § 3), and the hint comes after an
// attempt. One step per moment: its hour, its title, its sentence and the proof of its gesture (docs/methode.md, "Ce qui
// vaut pour tous les élèves", sources [11] and [13]) on the left; its screen facing them on the right, and what the
// screen shows in words for a screen reader; on a phone, one under the other. Two screens carry a gesture: at 17:35 the
// list falls into the pupil's order (`tonight-order`), at 18:00 a line strikes the step done.
const MOMENTS = [
  {
    time: HOURS.said,
    title: 'Votre enfant dit ses devoirs',
    body: 'Votre enfant dit ses devoirs à voix haute, comme ils viennent. Tom demande ce qui manque\xa0: pour quand, quels exercices, un contrôle bientôt.',
    described:
      'Exemple d’écran, mardi à 17\xa0h\xa030. Votre enfant dit ses devoirs à voix haute\xa0: de l’histoire, de l’anglais, les exercices 3 et 4 de maths. Tom lui demande pour quand est chaque devoir.',
  },
  {
    time: HOURS.ordered,
    title: 'Votre enfant choisit par où commencer',
    body: 'Tom propose un ordre et dit pourquoi. Votre enfant le garde ou le change.',
    described:
      'Exemple d’écran, mardi à 17\xa0h\xa035. Tom propose de commencer par les maths. Votre enfant préfère l’anglais. La liste devient anglais, maths, histoire, et Tom lui demande ce qu’il a à faire en anglais.',
    proof: {
      text: 'Planifier son travail et faire le point, c’est l’une des approches les mieux appuyées d’une grande synthèse de la recherche en éducation (355\xa0études).',
      sources: [
        {
          label: 'La source',
          href: 'https://educationendowmentfoundation.org.uk/education-evidence/teaching-learning-toolkit/metacognition-and-self-regulation',
          title: 'Education Endowment Foundation, « Metacognition and self-regulation »',
          name: 'Education Endowment Foundation',
        },
      ],
    },
  },
  {
    time: HOURS.started,
    title: 'Votre enfant avance par petites étapes',
    body: 'Tom découpe l’exercice en étapes courtes. Votre enfant essaie, et quand l’essai ne marche pas, Tom lui donne un indice.',
    described:
      'Exemple d’écran, mardi à 18\xa0h. L’exercice 3 de maths est découpé en trois étapes. Votre enfant essaie 10 comme dénominateur et voit que 4 ne va pas dans 10. Tom lui donne un indice\xa0: un nombre de la table de 4 et de celle de 6. Votre enfant trouve 12 et passe à l’étape 2.',
  },
  {
    time: HOURS.ended,
    title: 'Votre enfant fait le point et prépare son cartable',
    body: 'Tom montre ce qui est fait, ce qui reste et ce qui va dans le cartable.',
    described:
      'Exemple d’écran, mardi à 18\xa0h\xa050. Tom fait le point avec votre enfant. Fait\xa0: l’anglais, les exercices 3 et 4 de maths, le début de la révision d’histoire. Reste\xa0: la suite de la révision demain, pour le contrôle de jeudi. Dans le cartable\xa0: le cahier de maths. Un bouton permet à votre enfant de vous montrer ce point.',
    proof: {
      text: 'Réviser sur plusieurs jours en s’interrogeant aide beaucoup\xa0; relire ou surligner aide peu.',
      sources: [
        { label: 'La source', href: 'https://doi.org/10.1177/1529100612453266', title: 'Dunlosky et al., 2013', name: 'Dunlosky, 2013' },
        { label: 'Une autre source', href: 'https://doi.org/10.1037/bul0000309', title: 'Yang et al., 2021', name: 'Yang, 2021' },
      ],
    },
  },
];

// Exercise 3 cut into steps: the first is done once the pupil finds 12, the second is under way.
const STEPS = [
  { step: 'trouver un dénominateur commun', state: 'fait' },
  { step: 'écrire les deux fractions avec ce dénominateur', state: 'en cours' },
  { step: 'additionner', state: '' },
];

// Tom's order, then the pupil's: English first, the one thing docs/produit.md says he can change.
const [maths, history, english] = HOMEWORK;
const CHANGED = [english, maths, history];
---

<section id="soiree" class="scroll-mt-20 bg-background pt-6 pb-12 md:pt-8 md:pb-16 lg:pt-12 lg:pb-24">
  {/* The moments, held while they are scrolled (src/scripts/evening.ts): the script makes the track several windows
   * high and holds the scene under the header, its title on top, where each step takes the place of the one before,
   * with its rank among the four. Without it, if it fails, or under reduced motion, the four steps follow one another,
   * all shown; the hidden steps of the held scene stay in the page, in their order, for a screen reader and the
   * keyboard. */}
  <evening-scenes class="block">
    <div class="scene container max-w-5xl">
      <play-once class="heading mb-8 block lg:mb-14">
        <h2 data-reveal="rise" class="section-title max-w-3xl text-foreground">
          Tom suit votre enfant <mark class="highlighter">jusqu’au cartable</mark>
        </h2>
        <p data-reveal="rise" data-order="2" class="mt-4 text-lg text-foreground md:text-xl">
          Voici un mardi soir, moment par moment.
        </p>
      </play-once>
      <ol role="list" class="steps space-y-12 lg:space-y-16">
        {MOMENTS.map(({ time, title, body, described, proof }, index) => (
          <li role="listitem" data-step id={`etape-${String(index + 1)}`} class="scroll-mt-20">
            {/* In two columns, the screen spans both rows, and the proof stays right under the moment's sentence. Each
             * line of the text sits in its own mask, which it rises into when its step is shown. */}
            <div class="grid items-start gap-4 md:grid-cols-[minmax(0,1fr)_minmax(0,20rem)] md:grid-rows-[auto_1fr] md:gap-x-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,26rem)] lg:gap-x-16">
              <div data-text>
                {/* The hour stays under the section's title at every width. */}
                <h3 class="text-xl text-foreground sm:text-2xl">
                  <span class="mask block">
                    <time data-line datetime={time} class="block font-heading text-3xl font-extrabold text-primary tabular-nums lg:text-4xl">
                      {spokenHour(time)}
                    </time>
                  </span>
                  <span class="mask mt-1 block">
                    <span data-line class="block">
                      {title}
                    </span>
                  </span>
                </h3>
                <div class="mask mt-2">
                  <p data-line class="max-w-md text-lg text-foreground">
                    {body}
                  </p>
                </div>
                <p class="sr-only">{described}</p>
              </div>
              <div data-screen class="md:row-span-2">
                <Screen time={screenTime(time)}>
                  {index === 0 && (
                    <play-once class="stagger block space-y-3">
                      <PupilSays>J’ai de l’histoire, de l’anglais, et les exercices 3 et 4 de maths.</PupilSays>
                      <TomSays>Chaque devoir est pour quand&nbsp;?</TomSays>
                    </play-once>
                  )}
                  {index === 1 && (
                    <tonight-order class="block space-y-3">
                      {/* The order Tom proposes, the pupil's choice, Tom's answer, then the list in the pupil's order: once
                       * the step is shown, Tom answers, the list comes back in Tom's order, and each item leaves the place
                       * it had there for its new one. */}
                      <ol class="flex flex-col gap-2">
                        {HOMEWORK.map((item, position) => (
                          <li class="flex items-baseline gap-3 rounded-control px-3 py-2 ring-1 ring-border">
                            <span class="font-heading font-extrabold tabular-nums">{position + 1}</span>
                            <span class="font-bold">{item.subject}</span>
                          </li>
                        ))}
                      </ol>
                      <PupilSays>Je préfère commencer par l’anglais, c’est rapide.</PupilSays>
                      <div class="reply">
                        <TomSays>L’anglais passe en premier, puis les maths, puis l’histoire. Qu’est-ce que tu as à faire en anglais&nbsp;?</TomSays>
                      </div>
                      <ol class="reordered flex flex-col gap-2">
                        {CHANGED.map((item, position) => (
                          <li
                            data-before={HOMEWORK.indexOf(item) + 1}
                            class="flex items-baseline gap-3 rounded-control bg-accent px-3 py-2 text-accent-foreground ring-1 ring-border"
                          >
                            <span class="tonight-after font-heading font-extrabold tabular-nums">{position + 1}</span>
                            <span class="font-bold">{item.subject}</span>
                          </li>
                        ))}
                      </ol>
                    </tonight-order>
                  )}
                  {index === 2 && (
                    <play-once class="stagger block space-y-3">
                      <Exercise title="Maths · Exercice 3" statement={'Calcule 3/4\xa0+\xa05/6.'} />
                      <ol class="space-y-1.5 text-sm">
                        {STEPS.map(({ step, state }, position) => (
                          <li
                            class:list={[
                              'flex items-baseline gap-2 rounded-control px-3 py-1.5 ring-1 ring-border',
                              state === 'en cours' && 'bg-accent text-accent-foreground',
                            ]}
                          >
                            <span class="shrink-0 font-bold">Étape {position + 1}</span>
                            <span class:list={['relative', state === 'fait' && 'text-muted-foreground']}>
                              {step}
                              {state === 'fait' && (
                                <svg class="strike" viewBox="0 0 100 6" preserveAspectRatio="none" aria-hidden="true">
                                  <path pathLength="1" d="M1 4 C 25 2, 60 5, 99 2" />
                                </svg>
                              )}
                            </span>
                            {state && (
                              <span
                                class:list={['ml-auto shrink-0', state === 'en cours' ? 'text-accent-muted-foreground' : 'text-muted-foreground']}
                              >
                                {state}
                              </span>
                            )}
                          </li>
                        ))}
                      </ol>
                      <PupilSays>J’ai essayé 10, mais 4 ne va pas dans 10.</PupilSays>
                      <TomSays>Il faut un nombre qui est à la fois dans la table de 4 et dans celle de 6. Lequel vient en premier&nbsp;?</TomSays>
                      <PupilSays>12.</PupilSays>
                      <TomSays>12 convient. Étape 2&nbsp;: 3/4, ça fait combien de douzièmes&nbsp;?</TomSays>
                    </play-once>
                  )}
                  {index === 3 && (
                    <play-once class="stagger block space-y-4">
                      <TomSays>Voici le point de ce soir.</TomSays>
                      <CheckIn {...CHECK_IN} bag={BAG} />
                      <TomSays>Le cahier de maths est dans ton cartable&nbsp;?</TomSays>
                      {/* The screen's button, drawn: the screen only illustrates. */}
                      <p class="rounded-full px-4 py-2 text-center font-bold text-primary ring-2 ring-input">Montrer à un adulte de la maison</p>
                    </play-once>
                  )}
                </Screen>
              </div>
              {proof && (
                <div data-proof>
                  <Proof {...proof} class="text-muted-foreground" />
                </div>
              )}
            </div>
          </li>
        ))}
      </ol>
      <EveningTimeline times={MOMENTS.map(({ time }) => time)} />
    </div>
  </evening-scenes>
</section>

<style>
  /* At 17:35, once the step is shown, one after the other: Tom answers, the list comes back in Tom's order, then falls
   * into the pupil's (`tonight-order`, src/styles/global.css). Waiting while the script holds them, they are in place
   * without it. */
  tonight-order {
    --order-delay: calc(var(--duration-slow) * 3);
  }

  @media (prefers-reduced-motion: no-preference) {
    tonight-order[data-armed] :is(.reply, .reordered) {
      opacity: 0;
    }

    tonight-order[data-played] .reply {
      transition: opacity var(--duration-slow) var(--ease-standard) var(--duration-slow);
    }

    tonight-order[data-played] .reordered {
      transition: opacity var(--duration-slow) var(--ease-standard) calc(var(--duration-slow) * 2);
    }
  }

  /* The line that strikes the step done, within the words, on the reed: a mark of state (docs/charte.md, "Couleurs"). */
  .strike {
    position: absolute;
    inset-inline: 0;
    top: 50%;
    width: 100%;
    height: calc(var(--spacing) * 1.5);
    overflow: visible;
    fill: none;
    stroke: var(--color-highlight);
    stroke-width: calc(var(--spacing) / 2);
    stroke-linecap: round;
    stroke-dasharray: 1;
  }

  /* It is drawn once, when its step is shown (docs/charte.md, "Mouvement": the line that strikes the step done);
   * without a played screen, it is already drawn. */
  @media (prefers-reduced-motion: no-preference) {
    [data-played] .strike {
      animation: strike-through var(--duration-slow) var(--ease-standard) var(--duration-slow) both;
    }
  }

  @keyframes strike-through {
    from {
      stroke-dashoffset: 1;
    }
  }

  /* The held scene, only while the script holds it (`data-held`) and only without reduced motion: the track is about
   * four windows high, the scene stays under the header (h-16), and its steps lie on one another, each step's text and
   * screen at the size of the tallest (`--text-frame`, `--screen-frame`), so that the screen's frame never jumps. Only
   * the step shown has its text, its screen's content and its frame; the script plays the change between two steps
   * (src/scripts/evening.ts). A screen that does not fit under its text shrinks (`zoom`, set by the script). */
  @media (prefers-reduced-motion: no-preference) {
    evening-scenes[data-held] {
      height: calc(100svh * 4);
      view-timeline: --evening block;

      .scene {
        position: sticky;
        top: calc(var(--spacing) * 16);
        display: flex;
        flex-direction: column;
        gap: calc(var(--spacing) * 4);
        height: calc(100svh - var(--spacing) * 16);
        padding-block: calc(var(--spacing) * 4);
      }

      .steps {
        display: grid;
        flex: 1;
        min-height: 0;
      }

      [data-step] {
        grid-area: 1 / 1;
        align-self: start;
        margin: 0;
        pointer-events: none;
      }

      [data-step][data-shown] {
        pointer-events: auto;
      }

      .mask {
        overflow: clip;
        overflow-clip-margin: 0.1em;
      }

      [data-text] {
        min-height: var(--text-frame);
      }

      /* The screen's card and its content belong to the screen's component (`:global`). */
      [data-screen] > :global(*) {
        min-height: var(--screen-frame);
      }

      [data-step]:not([data-shown]) :is([data-line], [data-proof]) {
        opacity: 0;
      }

      [data-step]:not([data-shown]) [data-screen] > :global(* > *) {
        opacity: 0;
      }

      [data-step]:not([data-shown]) [data-screen] > :global(*) {
        background: transparent;
        box-shadow: none;
      }

      /* The title stays on top of the held scene, a section's title still: the room a step lacks is taken from its
       * screen, then from the spacings (`data-tight`, src/scripts/evening.ts), never from the title. */
      .heading {
        margin: 0;
      }

      .heading p {
        margin-top: calc(var(--spacing) * 1);
        font-size: var(--text-base);
        line-height: var(--text-base--line-height);
      }

      /* On a phone, the scene's margins, the step's own text and the lines of its lists are set a size down too, so
       * that its screen keeps a readable size. */
      @media (width < 48rem) {
        .scene {
          gap: calc(var(--spacing) * 2);
          padding-block: calc(var(--spacing) * 2);
        }

        [data-screen] li {
          padding-block: var(--spacing);
        }

        /* The frame follows each step's height (src/scripts/evening.ts): its content is clipped while it changes. Its
         * padding and the room between its messages are a size down. */
        [data-screen] > :global(*) {
          overflow: clip;
          padding: calc(var(--spacing) * 3);
        }

        [data-screen] > :global(* > p:first-child) {
          margin-bottom: calc(var(--spacing) * 2);
          padding-bottom: calc(var(--spacing) * 2);
        }

        [data-screen] :is(.space-y-3, .space-y-4) > :global(:not(:last-child)) {
          margin-block-end: calc(var(--spacing) * 2);
        }

        [data-screen] ol {
          gap: var(--spacing);
        }

        [data-step] > div {
          gap: calc(var(--spacing) * 2);
        }

        /* The introduction stays for a screen reader; the hours below say the same to the eye. */
        .heading p {
          position: absolute;
          width: 1px;
          height: 1px;
          overflow: hidden;
          clip-path: inset(50%);
          white-space: nowrap;
        }

        /* The hour and the step's title on one line where they fit. */
        [data-step] h3 {
          display: flex;
          flex-wrap: wrap;
          align-items: baseline;
          column-gap: calc(var(--spacing) * 2);
          font-size: var(--text-base);
          line-height: var(--text-base--line-height);
        }

        [data-step] h3 .mask {
          margin-top: 0;
        }

        [data-step] time {
          font-size: var(--text-xl);
          line-height: var(--text-xl--line-height);
        }

        [data-step] h3 + .mask {
          margin-top: var(--spacing);
        }

        [data-step] h3 + .mask p {
          font-size: var(--text-sm);
          line-height: var(--text-sm--line-height);
        }
      }
    }

    /* A window where the screens, shrunk as far as they go, still leave a step without room (src/scripts/evening.ts):
     * the scene's spacings tighten, the title keeps its size. */
    evening-scenes[data-held][data-tight] {
      .scene {
        gap: var(--spacing);
        padding-block: var(--spacing);
      }

      [data-step] > div {
        row-gap: var(--spacing);
      }

      [data-screen] > :global(*) {
        padding: calc(var(--spacing) * 2);
      }

      [data-screen] > :global(* > p:first-child) {
        margin-bottom: var(--spacing);
        padding-bottom: var(--spacing);
      }

      [data-screen] :is(.space-y-3, .space-y-4) > :global(:not(:last-child)) {
        margin-block-end: calc(var(--spacing) * 1.5);
      }
    }
  }
</style>
