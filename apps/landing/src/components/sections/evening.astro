---
import { Backpack } from '@lucide/astro';
import CheckIn from '@/components/molecules/check-in.astro';
import Proof from '@/components/molecules/proof.astro';
import PupilSays from '@/components/molecules/pupil-says.astro';
import Screen from '@/components/molecules/screen.astro';
import TomSays from '@/components/molecules/tom-says.astro';
import { spokenHour } from '@/lib/hours';
import { BAG, CHECK_IN, FIRST_SAID, HOMEWORK, HOURS, MISSING } from './evening-data';

// The evening of docs/produit.md, "Ce que fait Catiche", and its gestures in docs/methode.md, "Les gestes d'une soirée":
// the product presented in the present, as docs/produit.md describes it (docs/charte.md, "Les mots").
// A question or a hint is the bottom of Tom's ladder (docs/tuteur.md, § 3). One row per moment, like a chapter: its
// hour, its title and its sentence on the left, with the proof of its gesture under them (docs/methode.md, "Ce qui vaut
// pour tous les élèves", sources [11] and [13]); its screen facing them on the right; on a phone, one under the other.
// The rows' text stays still; each screen rises and grows slightly once as it comes into view, the section's strong
// moment, then its proof fades in. Two screens carry a gesture: at 17:35 the list falls into the pupil's order
// (`tonight-order`), at 18:00 a line strikes the step done.
const MOMENTS = [
  {
    time: HOURS.said,
    title: "Dire ce qu'il a ce soir",
    body: 'Votre collégien dit ses devoirs à voix haute, et Tom demande ce qui manque.',
  },
  {
    time: HOURS.ordered,
    title: 'Choisir par où commencer',
    body: "Tom propose les maths d'abord, pour demain. Votre collégien préfère l'anglais : c'est lui qui choisit.",
    proof: {
      before: "Planifier son travail et faire le point compte parmi les méthodes les mieux appuyées, d'après",
      figure: '355 études',
      after: '.',
      source: {
        href: 'https://educationendowmentfoundation.org.uk/education-evidence/teaching-learning-toolkit/metacognition-and-self-regulation',
        title: 'Education Endowment Foundation, « Metacognition and self-regulation »',
        name: 'Education Endowment Foundation',
      },
    },
  },
  {
    time: HOURS.started,
    title: 'Avancer par petites étapes',
    body: 'Tom découpe chaque devoir en étapes courtes, et aide par une question ou un indice.',
  },
  {
    time: HOURS.ended,
    title: 'Faire le point et préparer demain',
    body: "Tom fait le point avec votre collégien : ce qui est fait, ce qui reste. Puis il l'aide à préparer son cartable pour demain.",
    proof: {
      before: 'Réviser un contrôle sur',
      figure: 'plusieurs jours',
      after: ', plutôt que la veille, est jugé très utile par la recherche.',
      source: { href: 'https://doi.org/10.1177/1529100612453266', title: 'Dunlosky et al., 2013', name: 'Dunlosky, 2013' },
    },
  },
];

const STEPS = [
  { step: "Relire l'énoncé", state: 'fait' },
  { step: "Écrire ce qu'on cherche", state: 'en cours' },
  { step: 'Faire le calcul', state: '' },
];

// The jumble falling into Tom's order plays at the top of the page; here, the order is already proposed, and the pupil
// changes it, the one thing docs/produit.md says he can do with it: English first.
const [maths, history, english] = HOMEWORK;
const CHANGED = [english, maths, history];
---

<section id="soiree" class="scroll-mt-20 bg-background py-12 md:py-16 lg:py-24">
  <div class="container max-w-5xl">
    <play-once class="block">
      <h2 data-reveal="rise" class="section-title max-w-3xl text-foreground">
        Avec Tom, de 17&nbsp;h&nbsp;30 au cartable prêt.
      </h2>
    </play-once>

    <ol role="list" class="mt-8 space-y-12 lg:mt-14 lg:space-y-16">
      {MOMENTS.map(({ time, title, body, proof }, index) => (
        <li role="listitem">
          {/* In two columns (as in the evening check-in), the screen spans both rows, and the proof stays right under the
           * moment's sentence. The text stays still; only the screen arrives, then its proof. */}
          <play-once class="grid items-start gap-4 md:grid-cols-[minmax(0,1fr)_minmax(0,20rem)] md:grid-rows-[auto_1fr] md:gap-x-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,26rem)] lg:gap-x-16">
            <div>
              {/* The hour stays under the section's title at every width. */}
              <h3 class="text-xl text-foreground sm:text-2xl">
                <time datetime={time} class="block font-heading text-3xl font-extrabold text-primary tabular-nums lg:text-4xl">
                  {spokenHour(time)}
                </time>
                <span class="mt-1 block">{title}</span>
              </h3>
              <p class="mt-2 max-w-md text-lg text-foreground">{body}</p>
            </div>
            <div data-reveal="pop" class="md:row-span-2">
              <Screen>
                {index === 0 && (
                  <div class="space-y-3">
                    {/* The screen stops on Tom's question: his answer is the top of the page, at 17:35. */}
                    <PupilSays>{FIRST_SAID}</PupilSays>
                    <TomSays>{MISSING}</TomSays>
                  </div>
                )}
                {index === 1 && (
                  <tonight-order class="block space-y-3">
                    <PupilSays>Je préfère commencer par l&apos;anglais.</PupilSays>
                    <div class="tonight-after">
                      <TomSays>D&apos;accord. Puis les maths, elles sont pour demain.</TomSays>
                    </div>
                    {/* Tom's order first, then the pupil's: each item leaves the place it had in Tom's order. */}
                    <ol class="flex flex-col gap-2">
                      {CHANGED.map((item, position) => (
                        <li data-before={HOMEWORK.indexOf(item) + 1} class="flex items-baseline gap-3 rounded-control px-3 py-2 ring-1 ring-border">
                          <span class="tonight-after font-heading font-extrabold tabular-nums">{position + 1}</span>
                          <span class="font-bold">{item.subject}</span>
                          {item.note && <span class="ml-auto text-sm text-muted-foreground">{item.note}</span>}
                        </li>
                      ))}
                    </ol>
                  </tonight-order>
                )}
                {index === 2 && (
                  <div class="space-y-3">
                    <ol class="space-y-2">
                      {STEPS.map(({ step, state }, position) => (
                        <li
                          class:list={[
                            'flex items-baseline gap-3 rounded-control px-3 py-2 ring-1 ring-border',
                            state === 'en cours' && 'bg-accent text-accent-foreground',
                          ]}
                        >
                          <span class="font-heading font-extrabold tabular-nums">{position + 1}</span>
                          <span class:list={['relative', state === 'fait' && 'text-muted-foreground']}>
                            {step}
                            {state === 'fait' && (
                              <svg class="strike" viewBox="0 0 100 6" preserveAspectRatio="none" aria-hidden="true">
                                <path pathLength="1" d="M1 4 C 25 2, 60 5, 99 2" />
                              </svg>
                            )}
                          </span>
                          {state && (
                            <span class:list={['ml-auto text-sm', state === 'en cours' ? 'text-accent-muted-foreground' : 'text-muted-foreground']}>
                              {state}
                            </span>
                          )}
                        </li>
                      ))}
                    </ol>
                    <TomSays>Qu&apos;est-ce que l&apos;exercice te demande de trouver&nbsp;?</TomSays>
                  </div>
                )}
                {index === 3 && (
                  <div class="space-y-5">
                    {/* What is done and what is left first, the same as on the evening check-in; then the bag. */}
                    <CheckIn {...CHECK_IN} />
                    <div class="rounded-2xl border-2 border-input px-4 pt-3 pb-4">
                      <p class="flex items-center gap-2 text-sm font-bold text-muted-foreground">
                        <Backpack class="size-4 shrink-0" aria-hidden="true" />
                        Dans le cartable
                      </p>
                      <ul class="mt-2 space-y-1.5">
                        {BAG.map((item) => (
                          <li>{item}</li>
                        ))}
                      </ul>
                    </div>
                  </div>
                )}
              </Screen>
            </div>
            {proof && (
              <div data-reveal="fade" data-order="2">
                <Proof {...proof} class="text-muted-foreground" />
              </div>
            )}
          </play-once>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  /* The list falls into the pupil's order once its screen has arrived. */
  tonight-order {
    --order-delay: var(--duration-reveal);
  }

  /* The line that strikes the step done, within the words, in a quiet ink. */
  .strike {
    position: absolute;
    inset-inline: 0;
    top: 50%;
    width: 100%;
    height: calc(var(--spacing) * 1.5);
    overflow: visible;
    fill: none;
    stroke: var(--color-muted-foreground);
    stroke-width: calc(var(--spacing) / 2);
    stroke-linecap: round;
    stroke-dasharray: 1;
  }

  /* It is drawn once, when its screen has arrived (docs/charte.md, "Mouvement": the line that strikes the step done);
   * without a played screen, it is already drawn. */
  @media (prefers-reduced-motion: no-preference) {
    [data-played] .strike {
      animation: strike-through var(--duration-slow) var(--ease-standard) var(--duration-reveal) both;
    }
  }

  @keyframes strike-through {
    from {
      stroke-dashoffset: 1;
    }
  }
</style>
