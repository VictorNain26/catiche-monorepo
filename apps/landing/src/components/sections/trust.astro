---
import { KeyRound, MapPin, ShieldCheck } from '@lucide/astro';
import { BRAND_NAME } from '@/lib/brand';

// Why a family can trust Catiche, in everyday words: the commitments of docs/produit.md, "Nos engagements", the pupil's
// own space first (docs/tuteur.md, § 8), then the hosting (docs/architecture.md, "Hébergement"; docs/tuteur.md, § 2) and
// the data never sold (docs/produit.md, "Nos engagements"). The check of Tom's messages is said in the evening, at 18 h (sections/evening.astro); the fixed
// distress answer, written by a person, with the 3114 and a trusted adult, is docs/tuteur.md, § 4.
const COMMITMENTS = [
  {
    icon: KeyRound,
    key: 'Son espace est à lui',
    text: 'Votre enfant l’ouvre avec son propre code, sans adresse e‑mail. Vous voyez ce qu’il a fait, jamais ses conversations avec Tom.',
  },
  {
    icon: MapPin,
    key: 'Hébergé en France',
    text: `${BRAND_NAME} est hébergé à Paris, chez Clever Cloud. Mistral AI calcule les réponses de Tom en Europe.`,
  },
  {
    icon: ShieldCheck,
    key: 'Vos données ne sont pas vendues',
    text: 'Nous ne vendons ni vos données ni celles de votre enfant.',
  },
];
---

<section id="protection" class="scroll-mt-20 bg-background py-28 md:py-32 lg:py-40">
  {/* On a phone, one column: the title, the commitments, the 3114. From lg, two: the title and the 3114 on the left, the
   * commitments facing them on the right. */}
  <div class="container grid max-w-5xl gap-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] lg:grid-rows-[auto_1fr] lg:gap-x-16 lg:gap-y-10">
    <play-once class="block lg:col-start-1 lg:row-start-1">
      <h2 data-reveal="rise" class="section-title max-w-3xl text-foreground">
        Votre enfant travaille dans un espace <span class="highlighter">protégé</span>
      </h2>
    </play-once>

    {/* Each commitment by its key words, then its sentence: a list read at a glance, not three cards. A plain Lucide icon
     * in the ink marks each one beside its words (docs/charte.md, "Icônes"); the reed stays under the title, once in the
     * section ("Couleurs"). */}
    <play-once class="block max-w-3xl lg:col-start-2 lg:row-span-2 lg:row-start-1">
      <ul data-reveal="rise" aria-label="Nos engagements" class="space-y-6 lg:space-y-8">
        {COMMITMENTS.map(({ icon: Icon, key, text }) => (
          <li class="grid grid-cols-[auto_minmax(0,1fr)] gap-x-4">
            <Icon class="mt-0.5 size-6 text-foreground lg:mt-1" aria-hidden="true" />
            <p class="font-heading text-xl font-extrabold text-foreground lg:text-2xl">{key}</p>
            <p class="col-start-2 mt-1 text-lg text-foreground">{text}</p>
          </li>
        ))}
      </ul>
    </play-once>

    {/* The 3114 in a few plain sentences, each under 25 words (docs/charte.md, "Les mots"). The number calls from a
     * phone; its target is at least 44 px each way, its padding taken back by margins so that neither the words nor the
     * line move. */}
    <play-once class="block max-w-3xl lg:col-start-1 lg:row-start-2">
      <p data-reveal="fade" class="text-lg text-foreground">
        Si votre enfant écrit qu’il veut se faire du mal, la séance s’arrête. Votre enfant reçoit alors un message écrit par une personne, pas par
        Tom. Ce message lui donne le{' '}
        <a href="tel:3114" class="-mx-1.5 -my-2.5 inline-block px-1.5 py-2.5 text-primary underline underline-offset-4">
          3114
        </a>
        , le numéro national de prévention du suicide, gratuit et ouvert jour et nuit. Il l’invite aussi à parler à un adulte de confiance.
      </p>
    </play-once>
  </div>
</section>
