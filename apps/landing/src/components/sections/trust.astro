---
import FadeIn from '@/components/atoms/fade-in.astro';
import Note from '@/components/annotations/note.astro';
import Highlight from '@/components/annotations/highlight.astro';

// Each fact is checked against the docs: docs/tuteur.md § 2 (Mistral's EU endpoint), docs/architecture.md ("Hébergement", "Serveur").
const COMMITMENTS = [
  "L'IA vient de Mistral AI, une entreprise française. Ses modèles sont appelés sur leur service européen.",
  'Le service est hébergé par Clever Cloud, à Paris.',
  "Votre enfant n'a pas d'adresse e-mail chez nous. Il entre par un code qu'il est seul à connaître.",
  'Aucune publicité, aucune revente de données.',
  'Vous pouvez consulter, corriger ou supprimer ses données sur simple demande.',
];
---

<section class="py-16 lg:py-24">
  <FadeIn class="container grid max-w-5xl gap-10 md:grid-cols-[1fr_2fr] md:items-start">
    <Note class="md:mt-2">Ce qu&apos;on s&apos;engage à faire, et à ne pas faire.</Note>
    <div>
      <h2 class="mb-6 text-4xl text-foreground sm:text-5xl">
        Les données de votre enfant <Highlight>ne sont pas un produit</Highlight>
      </h2>
      <ul class="space-y-4 text-lg text-muted-foreground">
        {COMMITMENTS.map((item) => (
          <li class="border-l-2 border-success pl-4">{item}</li>
        ))}
      </ul>
      <p class="mt-6 text-muted-foreground">
        Le détail est dans notre{' '}
        <a href="/confidentialite" class="text-primary underline underline-offset-4">
          politique de confidentialité
        </a>
        .
      </p>
    </div>
  </FadeIn>
</section>
