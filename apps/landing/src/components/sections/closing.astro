---
import TomIllustration from '@/components/atoms/tom-illustration.astro';
import RequestInvitation from '@/components/molecules/request-invitation.astro';
import { BRAND_NAME } from '@/lib/brand';
---

{/* The end of the evening: Tom waves, without a word (docs/charte.md, "Tom": out of a session, he does not speak). On a
 * phone he already opens the page, right above the title: the end keeps only the question and the button. */}
<section class="bg-background pt-12 pb-12 md:pt-20 lg:pt-28 lg:pb-16">
  <div class="container grid max-w-6xl items-end gap-8 sm:grid-cols-[minmax(0,1fr)_minmax(0,16rem)] lg:grid-cols-[minmax(0,1fr)_minmax(0,20rem)]">
    <div class="sm:pb-8">
      <h2 class="max-w-2xl text-3xl text-balance text-foreground sm:text-4xl">{BRAND_NAME} vous intéresse&nbsp;?</h2>
      <RequestInvitation class="mt-6 sm:mt-8" />
    </div>
    <TomIllustration start="view" class="hidden sm:block sm:w-full" />
  </div>
</section>
