---
import TomIllustration from '@/components/atoms/tom-illustration.astro';
import RequestInvitation from '@/components/molecules/request-invitation.astro';
---

{/* The end of the page: a short title above the sections' scale, one button, and Tom large as the last word, on the
 * brand's light plane. The title rises, then the button; Tom arrives slowly as he comes into view (src/scripts/reveal.ts),
 * then waves once (docs/charte.md, "Tom": out of a session, he does not speak). */}
<section class="overflow-hidden plane-tint pt-28 md:pt-32 lg:pt-40">
  <div class="container grid max-w-5xl items-end gap-6 md:grid-cols-[minmax(0,1fr)_minmax(0,20rem)] lg:grid-cols-[minmax(0,1fr)_minmax(0,26rem)] lg:gap-12">
    {/* Its text stays above the plane's fade at the bottom (`plane-*`, src/styles/global.css), beside Tom. */}
    <play-once class="block pb-6 md:pb-28 lg:pb-36">
      <h2 data-reveal="rise" class="text-5xl text-balance text-foreground lg:text-7xl">
        Ce soir, on commence par quoi&nbsp;?
      </h2>
      <div data-reveal="rise" data-order="2">
        <RequestInvitation class="mt-8 lg:mt-10" />
      </div>
    </play-once>
    <play-once class="arrival mx-auto block w-64 sm:w-72 md:w-full">
      <TomIllustration start="arrival" class="max-w-none" />
    </play-once>
  </div>
</section>

<style>
  /* Tom arrives slowly from below, once, while the script holds him (src/scripts/reveal.ts); set at once while he
   * waits, only his arrival is a transition. */
  @media (prefers-reduced-motion: no-preference) {
    .arrival[data-played] {
      transition:
        translate var(--duration-arrive) var(--ease-out-expo),
        opacity var(--duration-arrive) var(--ease-out-expo);
    }

    .arrival[data-armed] {
      opacity: 0;
      translate: 0 calc(var(--spacing) * 12);
    }
  }
</style>
