---
import CheckIn from '@/components/molecules/check-in.astro';
import Screen from '@/components/molecules/screen.astro';
import { CHECK_IN, EVENING, HOURS } from './evening-data';

// The evening check-in of docs/produit.md ("Le point du soir"), not built yet: told in the present under the line that
// says so (docs/charte.md, "Les mots"); how it fits each family is a question of the FAQ. The adult sees that it is done,
// never the conversations (docs/tuteur.md, § 8). The pupil's own code has six digits (STUDENT_CODE_LENGTH,
// apps/server/src/domain/student-code.ts), without an e-mail address.
---

<section id="point-du-soir" class="scroll-mt-20 bg-secondary py-12 md:py-16 lg:py-32">
  <div class="container grid max-w-6xl items-center gap-10 md:grid-cols-[minmax(0,1fr)_minmax(0,20rem)] lg:grid-cols-[minmax(0,1fr)_minmax(0,24rem)] lg:gap-24">
    <div>
      <p class="font-bold text-primary">En préparation aussi&nbsp;: le point du soir.</p>
      <h2 class="mt-3 text-3xl text-balance text-foreground sm:text-4xl">Vous savez ce qui est fait, sans surveiller.</h2>
      <p class="mt-5 max-w-xl text-lg text-muted-foreground md:mt-6 md:text-xl">
        Votre collégien montre ce qu&apos;il a fait à l&apos;adulte de la maison, qui répond «&nbsp;Vu&nbsp;», avec un mot d&apos;encouragement
        s&apos;il le veut.
      </p>
      <p class="mt-4 max-w-xl text-lg text-muted-foreground md:text-xl">
        Ses échanges avec Tom restent à lui&nbsp;: il entre avec un code de six chiffres qu&apos;il choisit, sans adresse e-mail.
      </p>
    </div>

    <figure>
      <play-once class="block">
        {/* On the secondary plane, the dark card would melt into it: there, it takes the background. */}
        <Screen time={HOURS.ended} title={EVENING} class="dark:bg-background">
          <CheckIn {...CHECK_IN} />
          <p class="seen mt-4 border-t pt-3">
            <span class="text-sm font-bold text-muted-foreground">Votre réponse</span>
            <span class="mt-1 block font-heading text-2xl font-extrabold text-primary">Vu</span>
          </p>
        </Screen>
      </play-once>
      <figcaption class="sr-only">Le point du soir&nbsp;: ce qui est fait, ce qui reste, et votre «&nbsp;Vu&nbsp;».</figcaption>
    </figure>
  </div>
</section>

<style>
  /* Your « Vu » comes last, without a stamp, once the script that holds it plays it (src/scripts/evening.ts); set at
   * once while it waits, only its arrival is a transition. */
  @media (prefers-reduced-motion: no-preference) {
    play-once:not([data-armed]) .seen {
      transition: opacity var(--duration-base) var(--ease-standard) var(--duration-slow);
    }

    play-once[data-armed] .seen {
      opacity: 0;
    }
  }
</style>
