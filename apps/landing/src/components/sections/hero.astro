---
import { Check } from '@lucide/astro';
import TomIllustration from '@/components/atoms/tom-illustration.astro';
import OpenApp from '@/components/molecules/open-app.astro';
import Screen from '@/components/molecules/screen.astro';
import TomSays from '@/components/molecules/tom-says.astro';
import { BRAND_NAME } from '@/lib/brand';

// The evening of docs/produit.md, "Ce que fait Catiche": the order Tom proposes, a step done, a test kept for Thursday.
const TONIGHT = [
  { subject: 'Maths', task: 'Exercices 3 et 4', done: true },
  { subject: 'Anglais', task: "Les mots de l'unité 2", done: false },
  { subject: 'Histoire', task: 'Réviser le chapitre 4', done: false, test: 'Contrôle jeudi' },
];
---

<section class="overflow-hidden pt-8 pb-16 lg:pt-16 lg:pb-24">
  <div class="container grid max-w-6xl items-center gap-12 lg:grid-cols-[1fr_minmax(0,30rem)] lg:gap-12">
    <div>
      <p class="text-sm font-bold text-muted-foreground">En préparation · pour le collège, de la 6e à la 3e</p>

      <h1 class="mt-4 text-4xl text-balance text-foreground sm:text-6xl xl:text-7xl">
        Ce soir, votre enfant sait <span class="text-primary">par où commencer</span>.
      </h1>

      <p class="mt-6 max-w-xl text-lg text-muted-foreground md:text-xl">
        {BRAND_NAME} accompagne votre enfant pendant ses devoirs, du début à la fin&nbsp;: savoir quoi faire, s&apos;y mettre, aller au bout, préparer
        les contrôles. Sans faire le travail à sa place.
      </p>

      <OpenApp class="mt-8" />
    </div>

    <figure class="relative mx-auto flex w-full max-w-lg items-end justify-center">
      <figcaption class="sr-only">
        Un exemple de soirée&nbsp;: Tom propose un ordre, les maths sont faites, l&apos;anglais suit, puis la révision du contrôle d&apos;histoire de
        jeudi.
      </figcaption>
      {/* The arch, the entrance of the holt, behind Tom on the top of the site (docs/charte.md, "Formes et composition"). */}
      <div aria-hidden="true" class="absolute bottom-0 left-0 h-full w-2/5 rounded-t-full bg-secondary sm:w-1/2"></div>
      <TomIllustration class="relative -mr-4 w-2/5 shrink-0 self-end sm:-mr-12 sm:w-1/2" />
      <Screen class="relative mb-6 w-3/4 max-w-72 min-w-0 space-y-3 sm:w-3/5">
        <p class="font-heading text-base font-extrabold">Ce soir</p>
        <TomSays>Je te propose cet ordre. Tu peux le changer.</TomSays>
        <ol class="space-y-2">
          {TONIGHT.map(({ subject, task, done, test }, index) => (
            <li class="flex items-start gap-2 rounded-control bg-secondary p-2 text-secondary-foreground">
              {done ? (
                <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-success text-success-foreground">
                  <Check class="size-4" aria-hidden="true" />
                </span>
              ) : (
                <span class="flex size-6 shrink-0 items-center justify-center rounded-full ring-2 ring-input">{index + 1}</span>
              )}
              <span class="min-w-0">
                <span class="block font-bold">{subject}</span>
                <span class="block text-muted-foreground">{task}</span>
                {test && (
                  <span class="mt-1 inline-block rounded-control whitespace-nowrap bg-warning px-2 py-0.5 font-bold text-warning-foreground">
                    {test}
                  </span>
                )}
              </span>
            </li>
          ))}
        </ol>
      </Screen>
    </figure>
  </div>
</section>
