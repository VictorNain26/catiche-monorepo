---
import { Mic } from '@lucide/astro';
import TomIllustration from '@/components/atoms/tom-illustration.astro';
import OpenApp from '@/components/molecules/open-app.astro';
import Screen from '@/components/molecules/screen.astro';
import TomSays from '@/components/molecules/tom-says.astro';
import { BRAND_NAME } from '@/lib/brand';

// The evening of docs/produit.md, "Ce que fait Catiche": the homework said in a jumble, then the order Tom proposes.
// `spoken` is each one's place in what the pupil said; the list is written in Tom's order, its end state.
const TONIGHT = [
  { subject: 'Maths', task: 'Exercices 3 et 4', spoken: 3 },
  { subject: 'Anglais', task: "Les mots de l'unité 2", spoken: 1 },
  { subject: 'Histoire', task: 'Réviser, contrôle jeudi', spoken: 2 },
];
---

<section class="overflow-hidden pt-10 pb-20 lg:pt-16 lg:pb-32">
  <div class="container grid max-w-6xl items-center gap-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,30rem)] lg:gap-16">
    <div>
      <h1 class="text-5xl text-balance text-foreground sm:text-6xl xl:text-7xl">
        Ce soir, votre enfant sait <mark class="highlighter">par où commencer</mark>.
      </h1>
      <p class="mt-8 max-w-xl text-lg text-muted-foreground md:text-xl">
        {BRAND_NAME} accompagne votre enfant pendant ses devoirs, du début à la fin&nbsp;: savoir quoi faire, s&apos;y mettre, aller au bout, préparer
        les contrôles. Sans faire le travail à sa place.
      </p>
      <OpenApp class="mt-10" />
    </div>

    {/* Tom in his arch, and the screen of the evening laid over its foot. */}
    <figure class="mx-auto flex w-full max-w-md flex-col lg:max-w-none">
      <figcaption class="sr-only">
        Un exemple de soirée&nbsp;: votre enfant dit ses devoirs dans le désordre, et Tom propose un ordre&nbsp;: les maths, l&apos;anglais, puis la
        révision du contrôle d&apos;histoire de jeudi.
      </figcaption>
      <TomIllustration arch class="-mb-16 w-2/3 max-w-none self-end sm:-mb-24" />
      <tonight-order class="relative block w-11/12 max-w-sm sm:w-4/5">
        <Screen time="17:30" title="Ce soir">
          <p class="ml-auto flex w-fit max-w-11/12 items-start gap-2 rounded-2xl bg-accent px-3 py-2 text-sm text-accent-foreground">
            <Mic class="mt-0.5 size-4 shrink-0" aria-hidden="true" />
            J&apos;ai anglais, un contrôle d&apos;histoire jeudi, et les exercices 3 et 4 en maths.
          </p>
          <div class="tonight-after mt-4">
            <TomSays>Je te propose cet ordre. Tu peux le changer.</TomSays>
          </div>
          <ol class="mt-3 flex flex-col gap-2">
            {TONIGHT.map(({ subject, task, spoken }, index) => (
              <li data-spoken={spoken} class="tonight-item flex items-baseline gap-3 rounded-control bg-accent px-3 py-2 text-accent-foreground">
                <span class="tonight-after font-heading font-extrabold tabular-nums">{index + 1}</span>
                <span class="min-w-0">
                  <span class="font-bold">{subject}</span> <span class="text-sm text-accent-muted-foreground">{task}</span>
                </span>
              </li>
            ))}
          </ol>
        </Screen>
      </tonight-order>
    </figure>
  </div>
</section>

<style>
  /* The reed lays itself behind the words, once, as the page opens. */
  @media (prefers-reduced-motion: no-preference) {
    .highlighter {
      animation: lay-highlight var(--duration-slow) var(--ease-standard) var(--duration-base) both;
    }
  }

  /* The jumble: the homework in the order it was said, out of line, before Tom's order; only while the script that sorts
   * it holds it (src/scripts/evening.ts). */
  .tonight-item,
  .tonight-after {
    transition:
      translate var(--duration-slow) var(--ease-standard) var(--duration-wait),
      opacity var(--duration-slow) var(--ease-standard) var(--duration-wait);
  }

  @media (prefers-reduced-motion: no-preference) {
    tonight-order[data-armed] {
      .tonight-item[data-spoken='1'] {
        order: 1;
        translate: calc(var(--spacing) * 2) 0;
      }

      .tonight-item[data-spoken='2'] {
        order: 2;
        translate: calc(var(--spacing) * -1) 0;
      }

      .tonight-item[data-spoken='3'] {
        order: 3;
        translate: calc(var(--spacing) * 3) 0;
      }

      .tonight-after {
        opacity: 0;
      }
    }
  }
</style>
