---
import { Hourglass } from '@lucide/astro';
import { buttonVariants } from '@repo/ui/classes';
import TomIllustration from '@/components/atoms/tom-illustration.astro';
import Highlight from '@/components/annotations/highlight.astro';
import { BRAND_NAME } from '@/lib/brand';
---

<section class="py-10 lg:py-24">
  <div class="container grid w-full grid-cols-1 items-center gap-10 lg:grid-cols-[3fr_2fr] lg:gap-16">
    <div>
      <span class="inline-flex items-center gap-2 rounded-full bg-card px-3 py-1 text-sm font-bold ring-1 ring-border">
        <Hourglass class="size-4 shrink-0 text-success" aria-hidden="true" />
        En préparation&nbsp;: l&apos;application n&apos;est pas encore ouverte
      </span>

      <h1 class="mt-4 text-4xl text-balance text-foreground sm:text-6xl xl:text-7xl">
        Ce soir, votre enfant sait <Highlight>par où commencer</Highlight>.
      </h1>

      <p class="mt-6 max-w-xl text-lg text-muted-foreground md:text-xl">
        {BRAND_NAME} accompagne votre collégien pendant ses devoirs, du début à la fin&nbsp;: savoir quoi faire, s&apos;y mettre, aller au bout,
        préparer les contrôles. Sans faire le travail à sa place.
      </p>

      <a href="#prevenu" class={buttonVariants({ size: 'lg', className: 'mt-8' })}>
        Être prévenu de l&apos;ouverture
      </a>
    </div>

    <TomIllustration class="mx-auto w-40 sm:w-56 lg:w-full" />
  </div>
</section>
