---
import TomIllustration from '@/components/atoms/tom-illustration.astro';
import PupilSays from '@/components/molecules/pupil-says.astro';
import RequestInvitation from '@/components/molecules/request-invitation.astro';
import Screen from '@/components/molecules/screen.astro';
import TomSays from '@/components/molecules/tom-says.astro';
import { BRAND_NAME } from '@/lib/brand';
import { EVENING, HOMEWORK, HOURS, ORDER_PROPOSED, SPOKEN } from './evening-data';

// What Catiche is, for whom, and what to do now (docs/charte.md, "Les mots"): docs/produit.md, "En une phrase"; the
// evening is what we are building ("À construire"), accounts open on invitation ("L'accès pendant la préparation").
// Beside it, Tom steps out of the evening: the homework said in a jumble falls into his order, once, as the page opens.
---

<section class="flex min-h-[calc(100svh-var(--spacing)*16)] items-center overflow-hidden py-10 lg:py-16">
  <div class="container grid max-w-7xl items-center gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,24rem)] xl:grid-cols-[minmax(0,1fr)_minmax(0,28rem)] xl:gap-16">
    <div>
      {/* Balanced lines, and « du début à la fin. » kept together, so the stroke is never cut in two. */}
      <h1 class="text-4xl leading-tight text-balance text-foreground sm:text-5xl xl:text-6xl xl:leading-tight">
        {BRAND_NAME} accompagne votre collégien pendant ses devoirs,{' '}
        <span class="whitespace-nowrap">
          <mark class="highlighter">du début à la fin</mark>.
        </span>
      </h1>
      <p class="mt-6 max-w-xl text-lg text-foreground">
        Nous construisons Tom, le tuteur de {BRAND_NAME}&nbsp;: une intelligence artificielle qui l&apos;aide chaque soir à s&apos;organiser, sans
        faire le travail à sa place.
      </p>
      <RequestInvitation status="En préparation · ouverture sur invitation" class="mt-8" />
    </div>

    {/* The card of the evening on a halo of water, and Tom stepping out of it: on a phone he stands under its lower edge,
     * which leaves him room; at a computer, in front of its left third, which its content leaves free. His feet are
     * below the card, on a soft contact shadow. */}
    <figure class="relative isolate mb-36 sm:mb-40 lg:mb-12">
      <span aria-hidden="true" class="halo absolute -inset-16 -z-10"></span>
      <figcaption class="sr-only">
        Un exemple, un mardi soir à 17&nbsp;h&nbsp;35&nbsp;: votre collégien dit pour quand sont ses devoirs, dans le désordre, et Tom lui propose un
        ordre&nbsp;: d&apos;abord les maths, pour demain, puis une partie de l&apos;histoire, pour le contrôle de jeudi, et l&apos;anglais, pour
        vendredi. C&apos;est votre collégien qui choisit l&apos;ordre.
      </figcaption>
      <tonight-order class="relative block">
        <Screen time={HOURS.ordered} title={EVENING} class="pb-24 shadow-control-hover lg:pb-5 lg:pl-32 xl:pl-40">
          <PupilSays>{SPOKEN}</PupilSays>
          <ol class="mt-4 flex flex-col gap-2">
            {HOMEWORK.map(({ subject, note, spoken }, position) => (
              <li data-spoken={spoken} class="tonight-item flex items-baseline gap-3 rounded-control bg-accent px-3 py-2 text-accent-foreground">
                <span class="tonight-after font-heading font-extrabold tabular-nums">{position + 1}</span>
                <span class="font-bold">{subject}</span>
                {note && <span class="ml-auto text-sm text-accent-muted-foreground">{note}</span>}
              </li>
            ))}
          </ol>
          <div class="tonight-after mt-4">
            <TomSays>{ORDER_PROPOSED}</TomSays>
          </div>
        </Screen>
      </tonight-order>
      <div class="pointer-events-none absolute -bottom-36 left-0 w-60 sm:-bottom-40 sm:w-64 lg:-bottom-12 lg:-left-28 lg:w-80 xl:-left-40 xl:w-100">
        <span aria-hidden="true" class="absolute inset-x-1/4 bottom-1 h-4 rounded-full bg-overlay/30 blur-md"></span>
        <TomIllustration class="max-w-none" />
      </div>
    </figure>
  </div>
</section>

<style>
  /* The reed lays itself behind the words, once, as the page opens. */
  @media (prefers-reduced-motion: no-preference) {
    .highlighter {
      animation: lay-highlight var(--duration-slow) var(--ease-standard) var(--duration-base) both;
    }
  }

  /* The jumble: the homework in the order it was said, out of line, before Tom's order; only while the script that sorts
   * it holds it (src/scripts/evening.ts). The jumble is set at once, and only its release is a transition. */
  @media (prefers-reduced-motion: no-preference) {
    tonight-order:not([data-armed]) :is(.tonight-item, .tonight-after) {
      transition:
        translate var(--duration-slow) var(--ease-standard) var(--duration-wait),
        opacity var(--duration-slow) var(--ease-standard) var(--duration-wait);
    }

    tonight-order[data-armed] {
      .tonight-item[data-spoken='1'] {
        order: 1;
        translate: calc(var(--spacing) * 2) 0;
      }

      .tonight-item[data-spoken='2'] {
        order: 2;
        translate: calc(var(--spacing) * -1) 0;
      }

      .tonight-item[data-spoken='3'] {
        order: 3;
        translate: calc(var(--spacing) * 3) 0;
      }

      .tonight-after {
        opacity: 0;
      }
    }
  }
</style>
