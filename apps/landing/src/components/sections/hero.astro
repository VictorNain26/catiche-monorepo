---
import TomIllustration from '@/components/atoms/tom-illustration.astro';
import PupilSays from '@/components/molecules/pupil-says.astro';
import RequestInvitation from '@/components/molecules/request-invitation.astro';
import Screen from '@/components/molecules/screen.astro';
import TomSays from '@/components/molecules/tom-says.astro';
import { BRAND_NAME } from '@/lib/brand';
import { HOMEWORK, HOURS, ORDER_PROPOSED, SPOKEN } from './evening-data';

// The first two moments of the evening in one screen: the homework said in a jumble, then the order Tom proposes.
---

<section class="overflow-hidden pt-10 pb-20 lg:pt-16 lg:pb-32">
  <div class="container grid max-w-6xl items-center gap-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,30rem)] lg:gap-16">
    <div>
      <h1 class="text-4xl text-balance text-foreground sm:text-5xl xl:text-6xl">
        {BRAND_NAME} accompagne votre enfant pendant ses devoirs, <mark class="highlighter">du début à la fin</mark>.
      </h1>
      <p class="mt-6 max-w-xl text-lg text-muted-foreground md:text-xl">
        Une aide aux devoirs pour le collège, de la 6e à la&nbsp;3e. Chaque soir, votre enfant dit ce qu&apos;il a à faire, et Tom, le tuteur de{' '}
        {BRAND_NAME}, une intelligence artificielle, l&apos;aide à s&apos;organiser&nbsp;: par où commencer, des étapes courtes, le cartable du
        lendemain. Sans faire le travail à sa place.
      </p>
      {/* The frame of the present tense above, read before the button (docs/charte.md, "Les mots"). */}
      <p class="mt-4 max-w-xl text-lg font-bold text-foreground md:text-xl">
        {BRAND_NAME} est en préparation&nbsp;: voici ce que votre enfant y fera.
      </p>
      <RequestInvitation class="mt-6" />
    </div>

    {/* Tom in his arch, and the screen of the evening laid over its foot. */}
    <figure class="mx-auto flex w-full max-w-md flex-col lg:max-w-none">
      <figcaption class="sr-only">
        Un exemple de soirée&nbsp;: votre enfant dit ses devoirs dans le désordre, et Tom lui propose par où commencer&nbsp;: les maths,
        l&apos;anglais, puis la révision du contrôle d&apos;histoire de jeudi. Votre enfant peut changer l&apos;ordre.
      </figcaption>
      <TomIllustration arch class="-mb-16 w-2/3 max-w-none self-end sm:-mb-24" />
      <tonight-order class="relative block w-11/12 max-w-sm sm:w-4/5">
        <Screen time={HOURS.ordered} title="Ce soir">
          <PupilSays>{SPOKEN}</PupilSays>
          <div class="tonight-after mt-4">
            <TomSays>{ORDER_PROPOSED}</TomSays>
          </div>
          <ol class="mt-3 flex flex-col gap-2">
            {HOMEWORK.map(({ subject, task, spoken }, index) => (
              <li data-spoken={spoken} class="tonight-item flex items-baseline gap-3 rounded-control bg-accent px-3 py-2 text-accent-foreground">
                <span class="tonight-after font-heading font-extrabold tabular-nums">{index + 1}</span>
                <span class="min-w-0">
                  <span class="font-bold">{subject}</span> <span class="text-sm text-accent-muted-foreground">{task}</span>
                </span>
              </li>
            ))}
          </ol>
        </Screen>
      </tonight-order>
    </figure>
  </div>
</section>

<style>
  /* The reed lays itself behind the words, once, as the page opens. */
  @media (prefers-reduced-motion: no-preference) {
    .highlighter {
      animation: lay-highlight var(--duration-slow) var(--ease-standard) var(--duration-base) both;
    }
  }

  /* The jumble: the homework in the order it was said, out of line, before Tom's order; only while the script that sorts
   * it holds it (src/scripts/evening.ts). The jumble is set at once, and only its release is a transition. */
  @media (prefers-reduced-motion: no-preference) {
    tonight-order:not([data-armed]) :is(.tonight-item, .tonight-after) {
      transition:
        translate var(--duration-slow) var(--ease-standard) var(--duration-wait),
        opacity var(--duration-slow) var(--ease-standard) var(--duration-wait);
    }

    tonight-order[data-armed] {
      .tonight-item[data-spoken='1'] {
        order: 1;
        translate: calc(var(--spacing) * 2) 0;
      }

      .tonight-item[data-spoken='2'] {
        order: 2;
        translate: calc(var(--spacing) * -1) 0;
      }

      .tonight-item[data-spoken='3'] {
        order: 3;
        translate: calc(var(--spacing) * 3) 0;
      }

      .tonight-after {
        opacity: 0;
      }
    }
  }
</style>
