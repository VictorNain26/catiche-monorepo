---
import TomIllustration from '@/components/atoms/tom-illustration.astro';
import PupilSays from '@/components/molecules/pupil-says.astro';
import RequestInvitation from '@/components/molecules/request-invitation.astro';
import Screen from '@/components/molecules/screen.astro';
import TomSays from '@/components/molecules/tom-says.astro';
import { BRAND_NAME } from '@/lib/brand';
import { HOMEWORK, HOURS, ORDER_PROPOSED, SPOKEN, screenTime } from './evening-data';

// What Catiche is, for whom, and what to do now (docs/charte.md, "Les mots"): docs/produit.md, "En une phrase", told in
// the present, Tom introduced once as an artificial intelligence; its state is said here once, in the pill
// ("L'accès pendant la préparation").
// Beside it, Tom steps out of the evening: the homework said with its dates falls into his order, once, as the page opens.
---

<section class="flex min-h-[calc(100svh-var(--spacing)*16)] items-center overflow-hidden py-10 lg:py-16">
  <div class="container grid max-w-7xl items-center gap-12 lg:grid-cols-[minmax(0,1fr)_minmax(0,24rem)] xl:grid-cols-[minmax(0,1fr)_minmax(0,28rem)] xl:gap-16">
    {/* The text of the top of the page is shown at once, still: only what is scrolled to appears (.claude/rules/landing.md). */}
    <div>
      {/* Balanced lines; the reed under the word that carries the sentence (docs/charte.md, "Couleurs"). */}
      <h1 class="text-hero leading-tight text-balance text-foreground sm:text-5xl xl:text-6xl xl:leading-tight">
        Votre enfant apprend à <span class="highlighter">organiser</span> ses devoirs
      </h1>
      <p class="mt-6 max-w-xl text-lg text-foreground">
        Tom, le tuteur de {BRAND_NAME}, est une intelligence artificielle. Votre enfant lui dit ses devoirs et choisit par où commencer,
        de&nbsp;la&nbsp;6<sup>e</sup>&nbsp;à&nbsp;la&nbsp;3<sup>e</sup>.
      </p>
      <RequestInvitation status class="mt-8" />
    </div>

    {/* The card of the evening on a halo of water, and Tom stepping out of it: on a phone he stands under its lower edge,
     * which leaves him room; at a computer, in front of its left third, which its content leaves free. His feet are
     * below the card, on a soft contact shadow. */}
    {/* Until two columns hold it, the card keeps a readable width, centred with Tom. */}
    <figure class="relative isolate mb-36 w-full sm:mb-40 md:mx-auto md:max-w-xl lg:mb-12 lg:max-w-none">
      <span aria-hidden="true" class="halo absolute -inset-16 -z-10"></span>
      <figcaption class="sr-only">
        Exemple d’écran, un mardi à 17&nbsp;h&nbsp;35. Votre enfant dit pour quand est chaque devoir&nbsp;: l’anglais pour vendredi, les maths pour
        demain, un contrôle d’histoire jeudi. La liste se range&nbsp;: maths, histoire, anglais. Tom explique cet ordre et demande à votre enfant s’il
        le garde.
      </figcaption>
      <tonight-order class="relative block">
        <Screen time={screenTime(HOURS.ordered)} class="shadow-control-hover">
          {/* The screen's top line spans the card; its content leaves Tom his room, under it on a phone and on its left
           * at a computer. */}
          <div class="pb-24 lg:pb-0 lg:pl-32 xl:pl-40">
            <PupilSays>{SPOKEN}</PupilSays>
            <ol class="mt-4 flex flex-col gap-2">
              {HOMEWORK.map(({ subject, note, spoken }, position) => (
                <li
                  data-before={spoken}
                  class="flex flex-wrap items-baseline gap-x-3 rounded-control bg-accent px-3 py-2 text-accent-foreground ring-1 ring-border"
                >
                  <span class="tonight-after font-heading font-extrabold tabular-nums">{position + 1}</span>
                  <span class="font-bold">{subject}</span>
                  <span class="ml-auto text-sm text-accent-muted-foreground">{note}</span>
                </li>
              ))}
            </ol>
            <div class="tonight-after mt-4">
              <TomSays>{ORDER_PROPOSED}</TomSays>
            </div>
          </div>
        </Screen>
      </tonight-order>
      <div class="pointer-events-none absolute -bottom-36 left-0 w-60 sm:-bottom-40 sm:w-64 lg:-bottom-12 lg:-left-28 lg:w-80 xl:-left-40 xl:w-100">
        <span aria-hidden="true" class="absolute inset-x-1/4 bottom-1 h-4 rounded-full bg-overlay/30 blur-md"></span>
        <TomIllustration class="max-w-none" />
      </div>
    </figure>
  </div>
</section>

<style>
  /* The reed lays itself behind the words, once, as the page opens. */
  @media (prefers-reduced-motion: no-preference) {
    .highlighter {
      animation: lay-highlight var(--duration-slow) var(--ease-standard) var(--duration-base) both;
    }
  }

  /* The homework as it was said, in its order (`data-before`) and out of line, before it falls into Tom's order
   * (`tonight-order`, src/styles/global.css and src/scripts/evening.ts). */
  @media (prefers-reduced-motion: no-preference) {
    tonight-order[data-armed] {
      [data-before='1'] {
        translate: calc(var(--spacing) * 2) 0;
      }

      [data-before='2'] {
        translate: calc(var(--spacing) * -1) 0;
      }

      [data-before='3'] {
        translate: calc(var(--spacing) * 3) 0;
      }
    }
  }
</style>
