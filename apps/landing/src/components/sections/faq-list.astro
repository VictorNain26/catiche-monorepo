---
import { Plus } from '@lucide/astro';
import { cn } from '@repo/ui/classes';
import { FAQS } from './faq-data';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class={cn('border-y divide-y', className)}>
  {FAQS.map((faq) => (
    <details name="faq" class="group">
      <summary class="flex min-h-11 cursor-pointer list-none items-start justify-between gap-6 py-5 text-left focus-visible:ring-inset sm:py-6 [&::-webkit-details-marker]:hidden">
        <span class="font-heading text-lg font-extrabold text-foreground sm:text-xl">{faq.question}</span>
        <Plus
          class="mt-1 size-5 shrink-0 text-muted-foreground transition-transform duration-base group-open:rotate-45 group-hover:text-foreground"
          aria-hidden="true"
        />
      </summary>
      <div class="max-w-2xl space-y-3 pb-6 text-muted-foreground">
        <p>{faq.answer}</p>
        {faq.sources && (
          <ul class="flex flex-wrap gap-x-6">
            {faq.sources.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex min-h-11 items-center text-primary underline underline-offset-4"
                >
                  {label}
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </details>
  ))}
</div>

<style>
  /* An answer opens and closes in height; a browser without ::details-content opens it at once. */
  details {
    interpolate-size: allow-keywords;
  }

  details::details-content {
    height: 0;
    opacity: 0;
    overflow: clip;
    transition:
      height var(--duration-base),
      opacity var(--duration-base),
      content-visibility var(--duration-base) allow-discrete;
  }

  details[open]::details-content {
    height: auto;
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    details::details-content {
      transition: none;
    }
  }
</style>
