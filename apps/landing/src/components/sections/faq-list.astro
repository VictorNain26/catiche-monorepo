---
import { ChevronDown } from '@lucide/astro';
import { cn } from '@repo/ui/classes';
import { FAQS } from './faq-data';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<div class={cn('grid items-start gap-4', className)}>
  {FAQS.map((faq) => (
    <details
      name="faq"
      class="group overflow-hidden rounded-2xl bg-card shadow-sm ring-1 ring-border transition-shadow duration-base hover:ring-primary"
    >
      <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-4 p-4 text-left focus-visible:ring-inset sm:p-6 [&::-webkit-details-marker]:hidden">
        <span class="text-base font-bold text-foreground sm:text-lg">{faq.question}</span>
        <ChevronDown class="size-5 shrink-0 text-muted-foreground transition-transform duration-base group-open:rotate-180" aria-hidden="true" />
      </summary>
      <div class="space-y-3 px-4 pb-4 text-muted-foreground sm:px-6 sm:pb-6">
        <p>{faq.answer}</p>
        {faq.sources && (
          <ul class="flex flex-wrap gap-x-6">
            {faq.sources.map(({ href, label }) => (
              <li>
                <a
                  href={href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex min-h-11 items-center text-primary underline underline-offset-4"
                >
                  {label}
                </a>
              </li>
            ))}
          </ul>
        )}
      </div>
    </details>
  ))}
</div>

<style>
  /* An answer opens and closes in height; a browser without ::details-content opens it at once. */
  details {
    interpolate-size: allow-keywords;
  }

  details::details-content {
    height: 0;
    opacity: 0;
    overflow: clip;
    transition:
      height var(--duration-base),
      opacity var(--duration-base),
      content-visibility var(--duration-base) allow-discrete;
  }

  details[open]::details-content {
    height: auto;
    opacity: 1;
  }
</style>
