---
import { Plus } from '@lucide/astro';
import { cn } from '@repo/ui/classes';
import { CONTACT_EMAIL } from '@/lib/brand';
import { FAQS } from './faq-data';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

{/* An open answer takes a tinted ground; its « + », in the brand's water, turns into a « × », the list's only move. The
 * questions stay at the weight of running text, under the section's title; the first, on price and opening, is open. */}
<div class={cn('space-y-1', className)}>
  {FAQS.map((faq, index) => (
    <details name="faq" open={index === 0} class="group rounded-2xl transition-colors duration-base open:bg-background motion-reduce:transition-none">
      <summary class="flex min-h-11 cursor-pointer list-none items-start justify-between gap-6 px-4 py-4 text-left focus-visible:ring-inset sm:py-5 [&::-webkit-details-marker]:hidden">
        <span class="text-lg text-foreground sm:text-xl">{faq.question}</span>
        <Plus
          class="mt-1 size-5 shrink-0 text-primary transition-transform duration-base group-open:rotate-45 motion-reduce:transition-none"
          aria-hidden="true"
        />
      </summary>
      <div class="max-w-2xl px-4 pb-5 text-foreground">
        {/* The answers are plain text, for the page's FAQPage data too: our address becomes a link only here. */}
        <p>
          {faq.answer.split(CONTACT_EMAIL).map((part, index) => (
            <>
              {index > 0 && (
                <a href={`mailto:${CONTACT_EMAIL}`} class="text-primary underline underline-offset-4">
                  {CONTACT_EMAIL}
                </a>
              )}
              {part}
            </>
          ))}
        </p>
      </div>
    </details>
  ))}
</div>

<style>
  /* An answer opens and closes in height; a browser without ::details-content opens it at once. */
  details {
    interpolate-size: allow-keywords;
  }

  details::details-content {
    height: 0;
    opacity: 0;
    overflow: clip;
    transition:
      height var(--duration-base),
      opacity var(--duration-base),
      content-visibility var(--duration-base) allow-discrete;
  }

  details[open]::details-content {
    height: auto;
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    details::details-content {
      transition: none;
    }
  }
</style>
