---
import { Plus } from '@lucide/astro';
import { CONTACT_EMAIL } from '@/lib/brand';
import { FAQS } from './faq-data';
---

{/* An open answer lifts onto a card; its « + », in the brand's water, turns into a « × », the list's only move. Each
 * question is a heading, set at the weight of running text, under the section's title; the first, on price and
 * opening, is open. A question lights up under the pointer, and its focus ring follows its corners. The list reaches
 * into its padding, so that the questions' words fall on the column of the title.
 * Inside a `play-once`, they rise in a quick cascade, the fourth and the next ones together; the rise is on a wrapper,
 * so that it leaves the ground's own transition alone. */}
<div class="-mx-4 space-y-1">
  {FAQS.map((faq, index) => (
    <div data-reveal="rise" data-order={Math.min(index + 1, 4)}>
      <details name="faq" open={index === 0} class="group rounded-2xl transition-colors duration-base open:bg-card motion-reduce:transition-none">
        <summary class="flex min-h-11 cursor-pointer list-none items-start justify-between gap-6 rounded-2xl px-4 py-4 text-left transition-colors duration-base hover:bg-accent focus-visible:ring-inset motion-reduce:transition-none sm:py-5 [&::-webkit-details-marker]:hidden">
          <h3 class="font-sans text-lg font-normal tracking-normal text-foreground sm:text-xl">{faq.question}</h3>
          <Plus
            class="mt-1 size-5 shrink-0 text-primary transition-transform duration-base group-open:rotate-45 motion-reduce:transition-none"
            aria-hidden="true"
          />
        </summary>
        <div class="max-w-2xl px-4 pb-5 text-foreground">
          {/* The answers are plain text, for the page's FAQPage data too: our address becomes a link only here. */}
          <p>
            {faq.answer.split(CONTACT_EMAIL).map((part, index) => (
              <>
                {index > 0 && (
                  <a href={`mailto:${CONTACT_EMAIL}`} class="text-primary underline underline-offset-4">
                    {CONTACT_EMAIL}
                  </a>
                )}
                {part}
              </>
            ))}
          </p>
        </div>
      </details>
    </div>
  ))}
</div>

<style>
  /* An answer opens and closes in height; a browser without ::details-content opens it at once. */
  details {
    interpolate-size: allow-keywords;
  }

  details::details-content {
    height: 0;
    opacity: 0;
    overflow: clip;
    transition:
      height var(--duration-base),
      opacity var(--duration-base),
      content-visibility var(--duration-base) allow-discrete;
  }

  details[open]::details-content {
    height: auto;
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    details::details-content {
      transition: none;
    }
  }
</style>
