---
import { BRAND_NAME } from '@/lib/brand';

// The pupil and the parent of docs/produit.md, "Pour qui": where the evening goes wrong, before what Catiche does.
const EVENINGS = [
  'Votre enfant ne sait pas par où commencer.',
  "Le contrôle de jeudi est oublié jusqu'à mercredi soir.",
  'Vous rentrez à 19 h, et tout recommence.',
];
---

<section class="py-16 lg:py-24">
  <div class="container max-w-6xl">
    <h2 class="text-sm font-bold text-muted-foreground">Le soir, chez vous</h2>
    <ul class="mt-6 grid gap-6 md:grid-cols-3 md:gap-10">
      {EVENINGS.map((evening) => (
        <li class="border-t-2 border-annotation pt-4 font-heading text-2xl font-extrabold text-balance text-foreground">{evening}</li>
      ))}
    </ul>
    <p class="mt-10 max-w-2xl text-lg text-muted-foreground md:text-xl">
      {BRAND_NAME} est fait pour l&apos;enfant qui bloque sur l&apos;organisation plus que sur les leçons.{' '}
      <strong class="font-bold text-foreground">L&apos;organisation, ça s&apos;apprend.</strong>
    </p>
  </div>
</section>
