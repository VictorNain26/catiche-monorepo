---
import { buttonVariants } from '@repo/ui/classes';
import FadeIn from '@/components/atoms/fade-in.astro';
import { BRAND_NAME, CONTACT_EMAIL } from '@/lib/brand';

// The landing stays static until production exists: the one call to action is an e-mail (.claude/rules/landing.md).
const MAILTO = `mailto:${CONTACT_EMAIL}?subject=${encodeURIComponent(`Prévenez-moi de l'ouverture de ${BRAND_NAME}`)}`;
---

<section id="prevenu" class="scroll-mt-20 py-16 lg:py-24">
  <FadeIn class="container max-w-3xl text-center">
    <h2 class="text-4xl text-balance text-foreground sm:text-5xl">{BRAND_NAME} ouvrira d&apos;abord à quelques familles</h2>
    <p class="mx-auto mt-6 max-w-xl text-lg text-muted-foreground">Écrivez-nous pour en faire partie. Un e-mail suffit, son objet est déjà rempli.</p>
    <a href={MAILTO} class={buttonVariants({ size: 'lg', className: 'mt-8' })}>
      Être prévenu de l&apos;ouverture
    </a>
    <p class="mt-4 text-muted-foreground">
      Ou écrivez à{' '}
      <a href={MAILTO} class="font-bold text-primary underline underline-offset-4">
        {CONTACT_EMAIL}
      </a>
      .
    </p>
    <p class="mx-auto mt-8 max-w-xl text-sm text-muted-foreground">
      Nous gardons votre adresse pour vous écrire à l&apos;ouverture, puis nous l&apos;effaçons si vous ne nous rejoignez pas. Elle n&apos;est ni
      vendue ni utilisée pour autre chose. Le détail est dans notre{' '}
      <a href="/confidentialite" class="text-primary underline underline-offset-4">
        politique de confidentialité
      </a>
      .
    </p>
  </FadeIn>
</section>
