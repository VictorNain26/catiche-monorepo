---
import FadeIn from '@/components/atoms/fade-in.astro';
import Scribble from '@/components/annotations/scribble.astro';
import SectionHeader from '@/components/atoms/section-header.astro';

// The evening of docs/produit.md, "Ce que fait Catiche": only the help on an exercise is built, so the rest is told in the future.
const STEPS = [
  {
    title: "« Qu'est-ce que tu as ce soir ? »",
    body: 'Votre enfant dira ses devoirs à voix haute. Tom demandera ce qui manque : pour quand, quels exercices, un contrôle bientôt ?',
  },
  {
    title: 'Un ordre, puis de petites étapes',
    body: "Tom proposera par quoi commencer, et votre enfant pourra changer l'ordre. Chaque devoir sera coupé en étapes courtes, pour s'y mettre et tenir.",
  },
  {
    title: 'Une aide qui ne fait pas à sa place',
    body: 'Sur un exercice, Tom pose des questions et donne des indices. Il est conçu pour ne pas donner la réponse : votre enfant la cherche lui-même.',
  },
  {
    title: 'Le sac de demain, et les contrôles à venir',
    body: "À la fin, Tom fera le point : ce qui est fait, ce qui reste, le sac du lendemain. Un contrôle annoncé reviendra les jours d'avant, pour le réviser peu à peu.",
  },
];
---

<section id="soiree" class="scroll-mt-20 py-16 lg:py-24">
  <div class="container">
    <SectionHeader
      eyebrow="Ce que nous construisons"
      title="Une soirée avec Tom"
      description="Une soirée de devoirs, en quatre temps. L'aide sur un exercice existe déjà ; le reste est en construction."
    />
    <ol class="mx-auto grid max-w-6xl gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {STEPS.map((step, index) => (
        <li class="rounded-2xl bg-card p-6 shadow-sm ring-1 ring-border">
          <FadeIn delay={index * 0.15}>
            <Scribble class="mb-4 px-2 font-heading text-3xl text-annotation" delay={0.2 + index * 0.15}>
              {index + 1}
            </Scribble>
            <h3 class="mb-3 text-xl text-balance text-foreground">{step.title}</h3>
            <p class="text-muted-foreground">{step.body}</p>
          </FadeIn>
        </li>
      ))}
    </ol>
  </div>
</section>
