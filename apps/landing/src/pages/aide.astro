---
import PageLayout from '@/layouts/page-layout.astro';
import FaqList from '@/components/sections/faq-list.astro';
import { BRAND_NAME, CONTACT_EMAIL } from '@/lib/brand';

// The answers first; the address once, for what they do not cover.
---

<PageLayout title="Centre d'aide" description={`Les réponses aux questions fréquentes sur ${BRAND_NAME}.`}>
  <FaqList />
  <p class="mt-12 text-lg text-foreground">
    Pas de réponse ici&nbsp;? Écrivez à{' '}
    <a href={`mailto:${CONTACT_EMAIL}`} class="text-primary underline underline-offset-4">
      {CONTACT_EMAIL}
    </a>
  </p>
</PageLayout>
