---
import PageLayout from '@/layouts/page-layout.astro';
import { BRAND_NAME } from '@/lib/brand';

const DESCRIPTION = `Mentions légales de ${BRAND_NAME}\xa0: éditeur du site, hébergement et propriété intellectuelle.`;

// The publisher, an individual entrepreneur, as Victor gave him (2026-10-22): his address, his phone number and his
// SIREN in the national register of businesses, which a professional publisher must show (LCEN, art. 1-1).
const PUBLISHER = {
  address: ['19 rue Jean-Jacques-Rousseau', '94200 Ivry-sur-Seine', 'France'],
  phone: { href: 'tel:+33664422529', label: '+33\xa06\xa064\xa042\xa025\xa029' },
  siren: '937\xa0817\xa0914',
};
---

<PageLayout title="Mentions légales" metaDescription={DESCRIPTION}>
  <div class="legal-copy">
    <h2>Éditeur du site</h2>
    <p>Le site catiche.fr est édité par Victor Lenain, entrepreneur individuel (micro-entrepreneur).</p>
    <p>
      {PUBLISHER.address.map((line, index) => (
        <>
          {index > 0 && <br />}
          {line}
        </>
      ))}
    </p>
    <p>
      <strong>Téléphone&nbsp;:</strong> <a href={PUBLISHER.phone.href}>{PUBLISHER.phone.label}</a>
    </p>
    <p>
      <strong>SIREN&nbsp;:</strong> {PUBLISHER.siren}, inscrit au Registre national des entreprises (RNE)
    </p>
    <p>
      <strong>Directeur de la publication&nbsp;:</strong> Victor Lenain
    </p>
    <p>
      <strong>Contact&nbsp;:</strong> <a href="mailto:contact@catiche.fr">contact@catiche.fr</a>
    </p>

    <h2>Hébergement</h2>
    <p>
      Le site est hébergé par Clever Cloud SAS.
      <br />
      4 rue Voltaire
      <br />
      44000 Nantes
      <br />
      France
      <br />
      +33 2 85 52 07 69
    </p>

    <h2>Propriété intellectuelle</h2>
    <p>
      L’ensemble de ce site relève de la législation française et internationale sur le droit d’auteur et la propriété intellectuelle. Tous les droits
      de reproduction sont réservés, y compris pour les documents téléchargeables et les représentations iconographiques et photographiques.
    </p>
  </div>
</PageLayout>
