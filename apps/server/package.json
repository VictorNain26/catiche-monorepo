{
  "name": "@repo/server",
  "version": "2.0.0",
  "type": "module",
  "exports": {
    "./contract": {
      "types": "./dist/types/contract.d.ts"
    },
    "./student-age": {
      "types": "./src/domain/student-age.ts",
      "import": "./src/domain/student-age.ts"
    }
  },
  "scripts": {
    "dev": "bun --watch src/main.ts | pino-pretty",
    "start": "bun dist/main.js",
    "build": "bun build src/main.ts src/migrate.ts src/invite.ts --outdir dist --target bun --minify --sourcemap=linked --format esm",
    "typecheck": "bun --bun tsc --noEmit",
    "lint": "bun --bun eslint . --max-warnings 0",
    "test": "bun test",
    "db:generate": "bun --bun drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "bun src/migrate.ts",
    "invite": "bun src/invite.ts",
    "eval": "API_RATE_LIMIT=100000 bun src/evaluate.ts",
    "db:check": "bun --bun drizzle-kit check --config=drizzle.config.ts",
    "db:studio": "bunx drizzle-kit studio",
    "referential:extract": "bun src/referential/extract.ts",
    "build:types": "bun --bun tsc -p tsconfig.types.json"
  },
  "dependencies": {
    "@ai-sdk/mistral": "^4.0.65",
    "@better-auth/core": "^1.7.10",
    "@better-auth/passkey": "^1.7.10",
    "@hono/bun": "^1.0.1",
    "@mistralai/mistralai": "^2.7.0",
    "@opentelemetry/api": "^1.9.1",
    "@scaleway/sdk-client": "^2.12.1",
    "@scaleway/sdk-tem": "^2.15.0",
    "@simplewebauthn/server": "^13.3.3",
    "ai": "7.0.142",
    "better-auth": "^1.7.10",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "mathjs": "^15.2.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "rate-limiter-flexible": "11.2.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "bun-types": "^1.4.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-plugin-boundaries": "7.2.0",
    "pino-pretty": "^13.1.3",
    "typescript": "6.0.3",
    "unpdf": "^1.8.1"
  }
}
