{
  "name": "catiche",
  "private": true,
  "description": "Catiche : Tom, un tuteur IA des devoirs pour collégiens, et un tableau de bord pour le parent",
  "scripts": {
    "dev": "docker compose up -d --wait --wait-timeout 120 postgres && bun run --cwd apps/server db:migrate && turbo run dev",
    "dev:down": "docker compose down",
    "setup": "bun scripts/setup.mjs",
    "build": "turbo run build",
    "lint": "turbo run lint lint:scripts",
    "lint:scripts": "eslint scripts --max-warnings 0",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "db:generate": "bun run --cwd apps/server db:generate",
    "db:studio": "bun run --cwd apps/server db:studio",
    "postinstall": "lefthook install"
  },
  "devDependencies": {
    "@evilmartians/lefthook": "^2.1.14",
    "@repo/eslint-config": "workspace:*",
    "eslint": "^10.12.0",
    "knip": "6.37.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "sherif": "1.13.0",
    "turbo": "^2.11.7",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=24",
    "bun": ">=1.4.4"
  },
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "@evilmartians/lefthook",
    "esbuild",
    "sharp"
  ],
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": ">=0.25.0"
    },
    "postcss": {
      "source-map-js": "^1.2.2"
    },
    "@tailwindcss/node": {
      "source-map-js": "^1.2.2"
    },
    "katex": "^0.19.0",
    "zod": "^4.6.7"
  }
}
